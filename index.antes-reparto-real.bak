<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#183e35">
<meta name="description" content="Nuestro Presupuesto: finanzas, hogar y metas juntos. Una aplicación privada para organizar el dinero de tu hogar.">
<title>Nuestro Presupuesto · Finanzas en pareja</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='18' fill='%23183e35'/%3E%3Cpath d='M14 31 32 16l18 15v20H14Z' fill='none' stroke='%23c7edb2' stroke-width='4' stroke-linejoin='round'/%3E%3Cpath d='M25 42h14M32 35v14' stroke='%23c7edb2' stroke-width='4'/%3E%3C/svg%3E">
<style>
/* 1. Design tokens and reusable components. No external assets are required. */
:root{color-scheme:light;--bg:#f5f7f5;--card:#fff;--ink:#203c35;--text:#32483f;--muted:#697c73;--line:#e3eae5;--green:#28654a;--green-soft:#eaf3e7;--lime:#d8eec4;--blue:#5486ae;--blue-soft:#eaf1f8;--orange:#bd7e36;--orange-soft:#fbf1df;--red:#b44143;--red-soft:#faebeb;--nav:#173c33;--shadow:0 5px 24px #1d3e3207;--radius:18px}
[data-theme=dark]{color-scheme:dark;--bg:#111e19;--card:#1a2b24;--ink:#e6f0e9;--text:#d0dfd5;--muted:#a2b8aa;--line:#31463b;--green:#99d5a5;--green-soft:#253e2b;--lime:#375239;--blue:#91badb;--blue-soft:#263c4d;--orange:#e0b276;--orange-soft:#423522;--red:#f09799;--red-soft:#4a2b2d;--nav:#102e26;--shadow:none}
*{box-sizing:border-box}body{margin:0;background:var(--bg);font-family:"Segoe UI",system-ui,-apple-system,sans-serif;font-size:16px;line-height:1.5;color:var(--text)}button,input,select,textarea{font:inherit}button,a,input,select{touch-action:manipulation}button{cursor:pointer}button:disabled{opacity:.5;cursor:not-allowed}a{color:var(--green)}button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible{outline:3px solid var(--blue);outline-offset:3px}button{border:0}svg{vertical-align:middle;flex-shrink:0}h1,h2,h3,p{margin:0}h1,h2,h3{color:var(--ink)}h1{font-size:clamp(1.7rem,2.4vw,2.3rem);line-height:1.2;letter-spacing:-.065rem;font-weight:650}h2{font-size:1.15rem;letter-spacing:-.02rem;font-weight:650}h3{font-size:1rem;font-weight:650}small,.small{font-size:.875rem}b,strong{font-weight:650}.muted{color:var(--muted)}.positive{color:var(--green)}.negative{color:var(--red)}.blue{color:var(--blue)}.orange{color:var(--orange)}.mono{font-variant-numeric:tabular-nums}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);border:0}
.sidebar{width:234px;position:fixed;inset:0 auto 0 0;background:var(--nav);color:#c4d8ce;display:flex;flex-direction:column;padding:30px 18px 20px;z-index:30}.brand{display:flex;gap:12px;align-items:center;color:#fff;padding:0 12px 29px}.brand-mark{width:39px;height:43px;background:#d8eec4;color:#204b36;display:grid;place-items:center;border-radius:12px}.brand strong{font-size:1.02rem;line-height:1.25;display:block;font-weight:600}.brand small{color:#b4cbbd;font-size:.75rem}.nav-caption{font-size:.75rem;letter-spacing:.13em;padding:8px 14px 10px;color:#91b2a2}.nav{display:grid;gap:4px}.nav button{display:flex;align-items:center;gap:13px;padding:11px 14px;border-radius:10px;background:transparent;color:#c0d2c8;text-align:left;font-size:.94rem}.nav button:hover{background:#ffffff0b;color:#fff}.nav button.active{background:#d8eec4;color:#193b2b;font-weight:600}.nav button .nav-num{margin-left:auto;font-size:.75rem}.sidebar-foot{margin-top:auto;padding:20px 10px 0}.privacy{background:#ffffff08;border:1px solid #ffffff10;padding:14px;border-radius:12px;font-size:.8rem;line-height:1.55}.privacy strong{display:block;color:#d7e9df;margin-bottom:3px}.people{display:flex;align-items:center;gap:10px;padding:18px 2px 0;font-size:.83rem}.avatar{width:33px;height:33px;border-radius:50%;background:#d2dcbc;color:#284632;display:grid;place-items:center;font-size:.75rem;font-weight:700}.avatar.second{margin-left:-18px;background:#f0d8b8;border:2px solid var(--nav)}
.workspace{margin-left:234px}.topbar{height:82px;border-bottom:1px solid var(--line);padding:0 38px;display:flex;align-items:center;justify-content:space-between;gap:16px;background:var(--card)}.breadcrumb{font-size:.875rem;color:var(--muted);display:flex;gap:10px;align-items:center}.breadcrumb strong{font-weight:500;color:var(--ink)}.top-actions{display:flex;align-items:center;gap:12px}.icon-btn{width:38px;height:38px;display:inline-grid;place-items:center;border-radius:10px;background:transparent;color:var(--muted);border:1px solid var(--line)}.icon-btn:hover{background:var(--bg);color:var(--ink)}.month-control{display:flex;align-items:center;gap:6px}.month-control select{border:0;background:transparent;min-width:160px;color:var(--ink);font-weight:600;padding:8px 2px}.month-control .icon-btn{border:0;width:28px}.main{max-width:1530px;margin:auto;padding:34px 38px 45px}.heading{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:25px}.eyebrow{font-size:.75rem;letter-spacing:.11em;text-transform:uppercase;color:var(--muted);margin-bottom:7px;font-weight:600}.heading p{margin-top:8px;color:var(--muted);font-size:.94rem}.actions{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border-radius:10px;padding:10px 16px;background:var(--green);color:var(--card);font-size:.875rem;font-weight:600;min-height:42px;white-space:normal}.btn:hover{filter:brightness(.93)}.btn.secondary{background:var(--card);color:var(--ink);border:1px solid var(--line)}.btn.soft{background:var(--green-soft);color:var(--green)}.btn.danger{background:var(--red-soft);color:var(--red)}.btn.sm{font-size:.8rem;min-height:34px;padding:7px 11px}.link-btn{padding:0;background:none;color:var(--green);font-size:.85rem;font-weight:600;display:inline-flex;align-items:center;gap:6px}.statusbar{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:13px 18px;background:var(--green-soft);border-radius:12px;margin-bottom:22px;font-size:.875rem}.statusbar.warn{background:var(--orange-soft);color:var(--orange)}.statusbar.danger{background:var(--red-soft);color:var(--red)}.statusbar>div{display:flex;align-items:center;gap:10px}.badge{display:inline-flex;align-items:center;gap:5px;border-radius:6px;padding:3px 8px;font-size:.75rem;background:var(--bg);color:var(--muted);white-space:nowrap}.badge.green{background:var(--green-soft);color:var(--green)}.badge.yellow{background:var(--orange-soft);color:var(--orange)}.badge.red{background:var(--red-soft);color:var(--red)}
.stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-bottom:23px}.stat{padding:20px 21px;background:var(--card);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow)}.stat-top{display:flex;align-items:center;justify-content:space-between;gap:6px;font-size:.875rem;color:var(--muted)}.stat-icon{width:32px;height:32px;background:var(--bg);display:grid;place-items:center;border-radius:10px}.stat-number{font-size:clamp(1.65rem,2.15vw,2.25rem);letter-spacing:-.045em;line-height:1.2;margin:13px 0 8px;color:var(--ink);font-weight:650;white-space:nowrap;font-variant-numeric:tabular-nums}.stat small{font-size:.78rem;color:var(--muted)}.stat.featured{background:var(--nav);border-color:var(--nav);color:#d2e3d8}.stat.featured .stat-top,.stat.featured small{color:#c1d3c7}.stat.featured .stat-number{color:#e2f2d6}.stat.featured .stat-icon{background:#ffffff12}.stat.featured.negative-card{background:#733536;border-color:#733536}.stat.featured.negative-card .stat-number{color:#fff}
.grid{display:grid;gap:22px}.cols2{grid-template-columns:1fr 1fr}.cols3{grid-template-columns:repeat(3,minmax(0,1fr))}.dashboard-grid{grid-template-columns:minmax(0,1.1fr) minmax(0,1fr)}.card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:23px;box-shadow:var(--shadow);min-width:0}.card-head{display:flex;justify-content:space-between;align-items:center;gap:15px;margin-bottom:22px}.card-head p{font-size:.8rem;color:var(--muted);margin-top:3px}.card-head .link-btn{white-space:nowrap}.section-space{margin-top:23px}.divider{height:1px;background:var(--line);margin:20px 0}.donut-layout{display:flex;align-items:center;justify-content:space-around;gap:24px;padding:4px 0 11px}.donut{position:relative;flex-shrink:0;width:196px;height:196px;border-radius:50%;background:var(--bg);display:grid;place-items:center}.donut:before{content:"";position:absolute;inset:27px;background:var(--card);border-radius:50%}.donut-center{position:relative;text-align:center}.donut-center strong{display:block;font-size:1.45rem;letter-spacing:-.05em;color:var(--ink)}.donut-center small{font-size:.75rem;color:var(--muted)}.legend{flex:1;min-width:160px}.legend-row{display:flex;align-items:center;gap:8px;font-size:.82rem;padding:5px 0}.legend-row strong{margin-left:auto;font-size:.83rem;color:var(--ink);font-variant-numeric:tabular-nums}.dot{display:inline-block;width:9px;height:9px;border-radius:3px;flex-shrink:0}.card-footer{border-top:1px solid var(--line);padding-top:14px;margin-top:12px;color:var(--muted);font-size:.8rem;display:flex;justify-content:space-between;gap:15px}.goal-row{display:flex;align-items:center;gap:12px;margin-bottom:12px}.tile-icon{width:43px;height:43px;border-radius:13px;background:var(--orange-soft);color:var(--orange);display:grid;place-items:center;flex-shrink:0}.tile-icon.green{background:var(--green-soft);color:var(--green)}.tile-icon.blue{background:var(--blue-soft);color:var(--blue)}.goal-row h3{font-size:.94rem}.goal-row p{font-size:.78rem;color:var(--muted);margin-top:3px}.goal-row .badge{margin-left:auto}.progress{height:7px;background:var(--line);border-radius:9px;overflow:hidden;position:relative;margin-top:10px}.progress>span{height:100%;display:block;border-radius:9px;background:var(--green);transition:width .5s ease;max-width:100%}.progress.orange>span{background:#d5ab6c}.progress.blue>span{background:var(--blue)}.progress.red>span{background:var(--red)}.progress-label{display:flex;justify-content:space-between;gap:10px;font-size:.8rem;margin:10px 0 0;color:var(--muted)}.progress-label strong{color:var(--ink)}.goal-preview+.goal-preview{border-top:1px solid var(--line);margin-top:19px;padding-top:19px}.savings-number{font-size:1.85rem;letter-spacing:-.045em;font-weight:650;color:var(--ink);line-height:1.3;margin:15px 0 4px}.soft-card{background:var(--green-soft);border-color:transparent}.soft-card.amber{background:var(--orange-soft)}.detail-line{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:10px 0;font-size:.875rem}.detail-line+.detail-line{border-top:1px solid var(--line)}.detail-line .label{display:flex;align-items:center;gap:10px}.detail-line strong{color:var(--ink);white-space:nowrap}.notice{border:1px solid var(--line);background:var(--bg);border-radius:11px;padding:13px 15px;display:flex;gap:10px;align-items:flex-start;font-size:.85rem;line-height:1.6}.notice.warning{background:var(--orange-soft);border-color:transparent;color:var(--orange)}.notice.error{background:var(--red-soft);border-color:transparent;color:var(--red)}.notice.success{background:var(--green-soft);border-color:transparent;color:var(--green)}.notice svg{margin-top:3px}.quote{font-size:.9rem;line-height:1.7;font-style:italic;border-left:3px solid var(--green);padding-left:15px;margin-top:20px}.recommendation{display:flex;align-items:flex-start;gap:12px;padding:15px 0}.recommendation+.recommendation{border-top:1px solid var(--line)}.recommendation p{font-size:.85rem;margin-top:4px;color:var(--muted)}.recommendation .tile-icon{width:35px;height:35px;border-radius:10px}.empty{text-align:center;padding:32px 15px;color:var(--muted)}.empty .tile-icon{margin:0 auto 12px}.empty p{font-size:.875rem;margin:6px 0 15px}.footer{display:flex;align-items:center;justify-content:space-between;gap:16px;color:var(--muted);font-size:.75rem;margin-top:27px}.footer>span{display:flex;gap:6px;align-items:center}
/* 2. Forms, tables and dialogs. */
label{display:block;font-size:.875rem;font-weight:500;color:var(--text)}input,select,textarea{width:100%;min-width:0;border:1px solid var(--line);border-radius:9px;padding:10px 12px;background:var(--card);color:var(--ink);min-height:43px}input:disabled{background:var(--bg);opacity:.7}label input,label select{margin-top:6px}input[type=checkbox]{width:18px;height:18px;min-height:0;accent-color:var(--green);margin:0}input[type=range]{accent-color:var(--green);padding:0}input[type=file]{padding:9px}.field-grid{display:grid;grid-template-columns:1fr 1fr;gap:17px;align-items:end}.field-grid .full{grid-column:1/-1}.field-note{font-size:.78rem;color:var(--muted);margin-top:5px}.input-money{position:relative;display:block;margin-top:6px}.input-money>span{position:absolute;left:.75rem;top:50%;transform:translateY(-50%);line-height:1;pointer-events:none;color:var(--muted);font-size:.9rem}.input-money input{display:block;margin-top:0;padding-left:2rem}.form-row{display:grid;grid-template-columns:1fr 140px;gap:15px;align-items:center;padding:12px 0;border-bottom:1px solid var(--line)}.form-row:last-child{border:0}.form-row small{display:block;color:var(--muted);font-weight:400;margin-top:3px}.form-row input{margin-top:0;text-align:right}.form-section+.form-section{margin-top:27px}.form-section h3{margin-bottom:8px}.check{display:flex;align-items:center;gap:9px;font-weight:400;font-size:.85rem}.check input{margin:0}.filters{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:18px}.filters label{flex:1;min-width:140px;font-size:.78rem;color:var(--muted)}.table-scroll{overflow-x:auto}table{width:100%;border-collapse:collapse;text-align:left;font-size:.875rem}th{font-size:.75rem;color:var(--muted);font-weight:600;padding:12px 10px;border-bottom:1px solid var(--line);white-space:nowrap}td{padding:14px 10px;border-bottom:1px solid var(--line)}tbody tr:last-child td{border-bottom:0}td .sub{display:block;font-size:.75rem;color:var(--muted);margin-top:2px}.right{text-align:right}.nowrap{white-space:nowrap}.table-desc{max-width:340px;overflow-wrap:anywhere}.form-layout{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(280px,1fr);gap:22px;align-items:start}.sticky{position:sticky;top:22px}.chart-bar{display:grid;grid-template-columns:110px 1fr 90px;gap:12px;align-items:center;font-size:.8rem;margin:17px 0}.chart-bar .progress{margin:0;height:11px}.chart-bar strong{text-align:right;color:var(--ink)}.chart-legend{display:flex;gap:18px;font-size:.8rem;color:var(--muted);margin-top:10px}.line-chart{width:100%;height:auto;min-height:160px}.line-chart text{fill:var(--muted);font-family:inherit;font-size:12px}.goal-detail{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:20px 0}.goal-detail dt{font-size:.78rem;color:var(--muted)}.goal-detail dd{margin:3px 0 0;font-size:.94rem;color:var(--ink);font-weight:600}.goal-card .actions{border-top:1px solid var(--line);padding-top:18px;margin-top:18px}.goal-card h2{overflow-wrap:anywhere}.period-tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:20px}.period-tabs button{background:var(--card);color:var(--muted);border:1px solid var(--line);padding:9px 14px;border-radius:9px;font-size:.85rem}.period-tabs button.active{background:var(--green-soft);color:var(--green);border-color:var(--green)}details summary{cursor:pointer;font-weight:600;color:var(--ink)}details[open] summary{margin-bottom:15px}.forecast{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:24px}.forecast>div{background:var(--bg);border:1px solid var(--line);padding:15px 12px;border-radius:11px}.forecast small{display:block;color:var(--muted);font-size:.78rem}.forecast strong{display:block;color:var(--ink);font-size:1.12rem;margin-top:7px}.money-big{font-size:2.8rem;font-weight:650;letter-spacing:-.05em;color:var(--ink);line-height:1.2}.fund-row{display:flex;align-items:center;gap:12px;padding:13px 0}.fund-row+.fund-row{border-top:1px solid var(--line)}.fund-row>strong{margin-left:auto;white-space:nowrap}.fund-row small{display:block;color:var(--muted);font-size:.78rem}.helper-title{display:flex;align-items:center;gap:8px}.equipment-table input{min-width:90px;max-width:130px}.print-only{display:none}.mobile-menu{display:none}.fade-in{animation:enter .25s ease-out}@keyframes enter{from{opacity:.3;transform:translateY(5px)}to{opacity:1;transform:translateY(0)}}@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
dialog{padding:0;border:1px solid var(--line);border-radius:20px;background:var(--card);color:var(--text);width:min(590px,calc(100% - 30px));max-height:90dvh;box-shadow:0 24px 90px #0003}dialog::backdrop{background:#0e241b70;backdrop-filter:blur(3px)}.modal-head{display:flex;justify-content:space-between;align-items:center;gap:15px;padding:22px 25px;border-bottom:1px solid var(--line)}.modal-body{padding:23px 25px}.modal-actions{display:flex;justify-content:flex-end;gap:10px;padding:18px 25px;border-top:1px solid var(--line);background:var(--bg)}.form-error{color:var(--red);font-size:.875rem;padding-top:12px}.toast-region{position:fixed;bottom:22px;right:25px;z-index:100;display:grid;gap:8px;max-width:calc(100% - 36px)}.toast{background:var(--ink);color:var(--card);padding:13px 20px;border-radius:11px;box-shadow:0 7px 25px #0002;font-size:.875rem;animation:enter .2s ease}.toast.error{background:var(--red);color:#fff}.storage-alert{padding:12px 25px;background:var(--red-soft);color:var(--red);font-size:.875rem}.menu-shade{display:none}.numeric{font-variant-numeric:tabular-nums}
@media(min-width:1450px){.main{padding-top:38px}.stats{gap:20px}.stat{padding:23px}.donut{width:218px;height:218px}.card{padding:26px}}
@media(max-width:1180px){.sidebar{width:207px;padding-inline:12px}.workspace{margin-left:207px}.main{padding:28px 25px}.topbar{padding-inline:25px}.stats{gap:12px}.stat{padding:17px}.dashboard-grid{grid-template-columns:1fr 1fr}.donut-layout{flex-direction:column;gap:14px}.legend{width:100%}.donut{width:170px;height:170px}.donut:before{inset:23px}.cols3{grid-template-columns:repeat(2,minmax(0,1fr))}.cols3>.card:last-child{grid-column:1/-1}.brand{padding-inline:8px}.form-layout{grid-template-columns:minmax(0,1.5fr) minmax(255px,1fr)}}
@media(max-width:900px){.sidebar{transform:translateX(-100%);transition:transform .2s;width:250px}.workspace{margin-left:0}.mobile-menu{display:inline-grid}.topbar{height:70px;padding-inline:20px}.breadcrumb{display:none}.main{padding:25px 20px}.sidebar.open{transform:translateX(0)}.menu-shade.open{display:block;position:fixed;inset:0;background:#0005;z-index:29}.donut-layout{flex-direction:row}.form-layout{grid-template-columns:1fr}.sticky{position:static}.dashboard-grid{grid-template-columns:1fr 1fr}.donut-layout{flex-direction:column}.top-actions{margin-left:auto}}
@media(max-width:620px){.main{padding:23px 16px 30px}.topbar{padding-inline:13px;gap:8px}.top-actions{gap:7px}.month-control select{min-width:145px;font-size:.875rem}.topbar .print-btn{display:none}.heading{align-items:flex-start;gap:15px;margin-bottom:20px;flex-wrap:wrap}.heading .actions{width:100%}.heading .actions .btn{flex:1}.heading p{font-size:.875rem}h1{font-size:1.8rem}.stats{grid-template-columns:1fr 1fr;gap:10px}.stat{padding:16px 14px;border-radius:14px}.stat-number{font-size:1.65rem;margin:10px 0 6px}.stat-top{font-size:.78rem;gap:4px}.stat-icon{width:27px;height:27px}.stat small{font-size:.73rem;display:block}.dashboard-grid,.cols2,.cols3{grid-template-columns:1fr}.cols3>.card:last-child{grid-column:auto}.card{padding:20px}.grid{gap:16px}.donut-layout{flex-direction:row;gap:18px}.donut{width:150px;height:150px}.donut:before{inset:22px}.donut-center strong{font-size:1.1rem}.legend{min-width:125px}.legend-row{font-size:.75rem}.legend-row strong{font-size:.75rem}.statusbar{padding:12px;font-size:.8rem;align-items:flex-start}.statusbar>.badge{display:none}.card-head{gap:10px}.card-head h2{font-size:1.06rem}.field-grid{gap:14px}.form-row{grid-template-columns:1fr 115px;gap:10px}.footer{align-items:flex-start;flex-direction:column;gap:7px}.forecast{gap:8px}.forecast>div{padding:12px 9px}.forecast strong{font-size:.94rem}.money-big{font-size:2.4rem}.filters label{min-width:calc(50% - 10px)}.modal-body{padding:20px}.modal-head{padding:18px 20px}.modal-actions{padding:16px 20px}.chart-bar{grid-template-columns:85px 1fr 80px;gap:10px}.equipment-table{font-size:.8rem}.statusbar .link-btn{white-space:nowrap}}
@media(max-width:370px){.donut-layout{flex-direction:column}.legend{width:100%}.field-grid{grid-template-columns:1fr}.stat-number{font-size:1.45rem}.stat-icon{display:none}}
@media print{body{background:white!important;color:#222!important;font-size:10pt;--card:white;--ink:#183d31;--text:#222;--muted:#555;--bg:#f6f6f6;--line:#ddd;--green:#28654a;--green-soft:#eef5ed;--nav:#173c33;--orange-soft:#fbf1df;color-scheme:light}.sidebar,.topbar,.main,.menu-shade,dialog,.toast-region,.storage-alert{display:none!important}.workspace{margin:0}.print-only{display:block!important;padding:8mm}.print-only h1{font-size:23pt}.print-only h2{font-size:14pt}.print-only .card{box-shadow:none;break-inside:avoid;padding:16px}.print-only .stats{grid-template-columns:repeat(4,1fr);gap:10px}.print-only .stat-number{font-size:20pt}.print-only .stat{padding:14px}.print-only .grid{gap:14px}.print-only .donut-layout{flex-direction:row}.print-only .donut{width:150px;height:150px}.print-only .btn{display:none}*{-webkit-print-color-adjust:exact;print-color-adjust:exact}@page{size:A4;margin:12mm}}
.sidebar{overflow-y:auto}a.sr-only:focus{position:fixed;top:10px;left:10px;width:auto;height:auto;clip:auto;overflow:visible;padding:12px 18px;z-index:200;background:var(--card);color:var(--ink);border-radius:8px}
/* Compact print layout: the monthly plan, chart and goals share the first page. */
@media print{
 .print-only{padding:0}.print-only .heading{margin-bottom:16px}.print-only h1{font-size:20pt}.print-only h2{font-size:12pt}.print-only h3{font-size:10pt}
 .print-only .stats{margin-bottom:16px}.print-only .stat{padding:12px;box-shadow:none}.print-only .stat-number{font-size:17pt;margin:9px 0 6px}.print-only .stat-top{font-size:9pt}.print-only .stat-icon{display:none}.print-only .stat small{font-size:8pt}
 .print-only .grid{grid-template-columns:minmax(0,1fr) minmax(0,1fr);align-items:start}.print-only .card{padding:15px;break-inside:auto}.print-only .detail-line{font-size:9pt;padding:6px 0;break-inside:avoid}.print-only .section-space{margin-top:14px}.print-only .divider{margin:12px 0}
 .print-only .donut-layout{gap:12px;padding-top:14px}.print-only .donut{width:125px;height:125px}.print-only .donut:before{inset:18px}.print-only .donut-center strong{font-size:11pt}.print-only .donut-center small{font-size:7pt}.print-only .legend{min-width:95px}.print-only .legend-row{font-size:8pt;padding:4px 0;gap:5px}.print-only .legend-row strong{font-size:8pt}.print-only .dot{width:6px;height:6px}
 .print-only .progress-label,.print-only .field-note,.print-only .small{font-size:8pt}.print-only .progress{height:5px}.print-only .eyebrow{font-size:8pt}
}
/* NEOMAR's daily income journal. */
.daily-banner{display:flex;justify-content:space-between;align-items:center;gap:20px;background:var(--green-soft);border:1px solid var(--line);border-radius:14px;padding:17px 20px;margin-bottom:20px}.daily-banner .eyebrow{display:block;margin-bottom:4px}.daily-banner strong{display:block;color:var(--ink);font-size:1rem}.daily-banner p{font-size:.85rem;color:var(--muted);margin-top:4px}.daily-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:13px}.day-card{border:1px solid var(--line);border-radius:13px;background:var(--bg);padding:16px;display:flex;flex-direction:column;gap:13px;min-width:0}.day-card.recorded{background:var(--green-soft);border-color:var(--lime)}.day-top{display:flex;align-items:flex-start;gap:8px;flex-direction:column}.day-top>span:first-child{text-transform:capitalize;font-size:.875rem;font-weight:600;color:var(--ink)}.day-amount{font-size:1.55rem;font-weight:650;color:var(--ink);letter-spacing:-.035em;overflow-wrap:anywhere}.day-amount .muted{font-size:.95rem;font-weight:400;letter-spacing:0}.day-card .actions{margin-top:auto}.day-card p{overflow-wrap:anywhere}.day-card .icon-btn{width:34px;height:34px}
@media(max-width:1200px){.daily-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(max-width:620px){.daily-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.day-card{padding:13px;gap:11px}.day-amount{font-size:1.4rem}.daily-banner{align-items:flex-start;flex-direction:column;padding:17px}.daily-banner .btn{width:100%}.day-card .actions{gap:7px}}
@media(max-width:360px){.daily-grid{grid-template-columns:1fr}}
</style>
</head>
<body>
<a class="sr-only" href="#main">Ir al contenido</a>
<div id="storage-alert" role="alert"></div>
<button class="menu-shade" id="menu-shade" aria-label="Cerrar menú"></button>
<aside class="sidebar" id="sidebar" aria-label="Navegación principal"></aside>
<div class="workspace"><header class="topbar" id="topbar"></header><main class="main" id="main" tabindex="-1"></main><section id="print-report" class="print-only" aria-label="Informe mensual"></section></div>
<dialog id="dialog" aria-labelledby="modal-title"></dialog>
<div class="toast-region" id="toast-region" role="status" aria-live="polite"></div>
<input type="file" accept="application/json,.json" id="import-file" hidden>
<!-- APPLICATION_SCRIPT -->
<script>
/* Nuestro Presupuesto · Core financiero.
 * Todos los importes persistidos son enteros en centavos.
 * El presupuesto reserva dinero; el registro de movimientos representa hechos.
 * Un gasto dentro de su categoría usa esa reserva, no se vuelve a descontar.
 * Los saldos solo cambian por movimientos, saldos iniciales o cierre explícito.
 */
'use strict';
const APP_KEY = 'nuestro-presupuesto-v1';
const VERSION = 2;
const MAX_MONEY = 100000000000;
const expenseKeys = ['groceries','services','iess1','iess2','gas','maintenance'];
const fundKeys = ['rent','emergency','investment','maintenance'];
const colors = ['#568066','#769cba','#b4c6bd','#8ca775','#d5aa69','#a5a0ba'];
const categoryNames = {neomar:'NEOMAR · ingreso diario',groceries:'Compras del hogar',services:'Servicios y hogar',iess1:'IESS · integrante 1',iess2:'IESS · integrante 2',gas:'Gasolina',maintenance:'Mantenimiento moto',rent:'Renta que no pagamos',emergency:'Fondo de emergencia',investment:'Metas / inversión',personal1:'Dinero personal 1',personal2:'Dinero personal 2',other:'Otros gastos',bonus:'Bono',additional:'Ganancias adicionales',extra:'Ingreso extraordinario'};
const statusNames = {planned:'Planificado',active:'En curso',closed:'Cerrado'};
const typeNames = {income:'Ingreso',expense:'Gasto',saving:'Ahorro',transfer:'Transferencia'};
let storageProblem = '';
let page = 'home';
let transactionFilters = {month:'current',type:'',category:'',person:''};
let simulator = null;
let state;
const $ = (q, root=document) => root.querySelector(q);
const $$ = (q, root=document) => [...root.querySelectorAll(q)];
const clone = x => JSON.parse(JSON.stringify(x));
const uid = () => globalThis.crypto?.randomUUID?.() || 'id-'+Date.now().toString(36)+'-'+Math.random().toString(36).slice(2);
const escapeHtml = value => String(value??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const money = cents => (cents<0?'−':'')+'$'+new Intl.NumberFormat(state?.settings?.format==='us'?'en-US':'de-DE',{minimumFractionDigits:2,maximumFractionDigits:2}).format(Math.abs(cents)/100);
const percent = value => new Intl.NumberFormat('es-EC',{maximumFractionDigits:1}).format(value)+'%';
const amountInput = cents => (cents/100).toFixed(2);
const sum = values => values.reduce((a,b)=>a+b,0);
function cents(value, allowZero=true) {
  const text = String(value).trim().replace(',','.');
  if(!/^\d+(\.\d{1,2})?$/.test(text)) throw Error('Escribe un monto válido, con hasta dos decimales.');
  const [whole,fraction=''] = text.split('.');
  const result = Number(whole)*100 + Number(fraction.padEnd(2,'0'));
  if(!Number.isSafeInteger(result)||result>MAX_MONEY||result<0||(!allowZero&&result===0)) throw Error('El monto debe ser '+(allowZero?'cero o positivo.':'mayor que cero.'));
  return result;
}
function today() { const d=new Date(); return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0'); }
function validMonth(k){return typeof k==='string'&&/^\d{4}-(0[1-9]|1[0-2])$/.test(k)&&+k.slice(0,4)>=2000&&+k.slice(0,4)<=2200;}
function validDate(d){if(typeof d!=='string'||!/^\d{4}-\d{2}-\d{2}$/.test(d)||!validMonth(d.slice(0,7)))return false;const [y,m,day]=d.split('-').map(Number);return day>=1&&day<=new Date(y,m,0).getDate();}
function monthIndex(k){const[y,m]=k.split('-').map(Number);return y*12+m-1;}
function shiftMonth(k,delta){const i=monthIndex(k)+delta;return Math.floor(i/12)+'-'+String(i%12+1).padStart(2,'0');}
function monthName(k,short=false){const[y,m]=k.split('-').map(Number);const s=new Intl.DateTimeFormat('es-EC',{month:short?'short':'long',year:'numeric'}).format(new Date(y,m-1,1));return s.charAt(0).toUpperCase()+s.slice(1);}
function dateName(d){return new Intl.DateTimeFormat('es-EC',{day:'2-digit',month:'short',year:'numeric'}).format(new Date(d+'T12:00:00'));}
function lastDate(k){const[y,m]=k.split('-').map(Number);return k+'-'+new Date(y,m,0).getDate();}
function inputDate(){const d=today();return d.startsWith(state.selectedMonth)?d:state.selectedMonth+'-01';}
function baseBudget(){return {groceries:35000,services:15000,iess1:8483,iess2:8483,gas:6500,maintenance:8000,rent:20000,emergency:0,investment:0,personal1:10000,personal2:10000,goals:{}};}
function newMonth(key, source){
  if(source)return {key,status:'planned',incomeMode:'daily',income:clone(source.income),extra:source.extra,budget:clone(source.budget),essentials:clone(source.essentials),stable:source.stable,closed:null};
  const b=baseBudget();
  if(key<='2026-11')b.goals.furniture=75000;
  else if(key<='2027-01')b.goals.equipment=75000;
  return {key,status:key==='2026-09'?'active':'planned',incomeMode:'daily',income:[100000,100000],extra:0,budget:b,essentials:clone(expenseKeys),stable:false,closed:null};
}
function initialState(){
 const months={};for(let k='2026-09';k<='2027-02';k=shiftMonth(k,1))months[k]=newMonth(k);
 return {version:VERSION,updatedAt:null,selectedMonth:'2026-09',settings:{names:['Integrante 1','Integrante 2'],couple:'Nuestro hogar',format:'es',theme:'light',limit:10000,sameIess:true,autoRedirect:true},months,
 goals:[{id:'furniture',name:'Sala + comedor',target:150000,initial:0,due:'2026-11-30',start:'2026-10',monthly:75000},{id:'equipment',name:'Equipar nuestro hogar',target:150000,initial:0,due:'2027-01-31',start:'2026-12',monthly:75000}],initialFunds:{rent:0,emergency:0,investment:0,maintenance:0},transactions:[],
 equipment:[{id:'tv',name:'TV',dec:45000,jan:20000},{id:'tree',name:'Árbol de Navidad',dec:15000,jan:0},{id:'christmas',name:'Decoración navideña',dec:7500,jan:0},{id:'appliances',name:'Electrodomésticos',dec:0,jan:25000},{id:'dishes',name:'Vajilla',dec:0,jan:7500},{id:'organization',name:'Organización',dec:0,jan:5000},{id:'decoration',name:'Decoración',dec:0,jan:5000},{id:'lamps',name:'Lámparas',dec:0,jan:5000},{id:'linen',name:'Ropa de cama',dec:0,jan:7500},{id:'other',name:'Otros',dec:7500,jan:0}]};
}
function month(k=state.selectedMonth,s=state){return s.months[k];}
function goal(id,s=state){return s.goals.find(g=>g.id===id);}
function allFunds(s=state){return [...fundKeys,...s.goals.map(g=>'goal:'+g.id)];}
function fundName(id){return id.startsWith('goal:')?(goal(id.slice(5))?.name||'Meta'):categoryNames[id]||id;}
function categoryName(id){if(id==='iess1')return 'IESS · '+state.settings.names[0];if(id==='iess2')return 'IESS · '+state.settings.names[1];if(id==='personal1')return state.settings.names[0];if(id==='personal2')return state.settings.names[1];return id?.startsWith('goal:')?fundName(id):(categoryNames[id]||id);}
function personName(id){return id==='both'?'Ambos':state.settings.names[Number(id)-1]||'Ambos';}
function accountName(id){return {home:'Hogar',savings:'Ahorro',personal1:state.settings.names[0],personal2:state.settings.names[1]}[id]||id;}
function transactions(k=state.selectedMonth,s=state){return s.transactions.filter(t=>t.date.startsWith(k));}
function openingFund(id,s=state){return id.startsWith('goal:')?goal(id.slice(5),s)?.initial||0:s.initialFunds[id]||0;}
function balances(s=state,through=null){const result=Object.fromEntries(allFunds(s).map(f=>[f,openingFund(f,s)]));for(const t of s.transactions){if(through&&t.date.slice(0,7)>through)continue;if(t.type==='saving')result[t.to]+=t.amount;if(t.type==='transfer'){result[t.from]-=t.amount;result[t.to]+=t.amount;}if(t.type==='expense'&&t.from)result[t.from]-=t.amount;}return result;}
function savingsContributed(k,id,s=state){return sum(transactions(k,s).filter(t=>t.type==='saving'&&t.to===id).map(t=>t.amount));}
function spending(k,cat,s=state){return sum(transactions(k,s).filter(t=>t.type==='expense'&&!t.from&&t.category===cat).map(t=>t.amount));}
function goalProgress(g,s=state,through=null){const fund='goal:'+g.id;const spent=sum(s.transactions.filter(t=>t.type==='expense'&&t.from===fund&&(!through||t.date.slice(0,7)<=through)).map(t=>t.amount));const balance=balances(s,through)[fund]||0;const achieved=balance+spent;return {balance,spent,achieved,remaining:Math.max(0,g.target-achieved),pct:Math.min(100,achieved/g.target*100)};}
function requiredContribution(g,k=state.selectedMonth){const p=goalProgress(g,state,k);const start=k<g.start?g.start:k;const count=Math.max(0,monthIndex(g.due.slice(0,7))-monthIndex(start)+1);return {...p,months:count,required:p.remaining===0?0:count?Math.ceil(p.remaining/count):null};}
function planFunds(m){return {rent:m.budget.rent,emergency:m.budget.emergency,investment:m.budget.investment,maintenance:m.budget.maintenance,...Object.fromEntries(Object.entries(m.budget.goals).map(([id,v])=>['goal:'+id,v]))};}
function totals(k=state.selectedMonth,s=state,override=null){
 const m=override||month(k,s),b=m.budget,tx=transactions(k,s);
 const extraRecorded=sum(tx.filter(t=>t.type==='income').map(t=>t.amount));
 const income=m.incomeMode==='daily'?extraRecorded:sum(m.income)+m.extra+extraRecorded;
 const expenses=sum(expenseKeys.map(f=>b[f]));
 const savings=b.rent+b.emergency+b.investment+sum(Object.values(b.goals));
 const personal=b.personal1+b.personal2;
 const planned=expenses+savings+personal;
 let over=0;
 for(const cat of ['groceries','services','iess1','iess2','gas','personal1','personal2'])over+=Math.max(0,spending(k,cat,s)-b[cat]);
 over+=spending(k,'other',s);
 const allocations=planFunds(m);
 for(const f of allFunds(s))over+=Math.max(0,savingsContributed(k,f,s)-(allocations[f]||0));
 const spent=sum(tx.filter(t=>t.type==='expense').map(t=>t.amount));
 return {income,extraRecorded,expenses,savings,personal,planned,over,available:income-planned-over,plannedAvailable:income-planned,spent,funded:sum(tx.filter(t=>t.type==='saving').map(t=>t.amount)),essential:sum(m.essentials.map(c=>b[c])),goals:sum(Object.values(b.goals)),regularSavings:b.rent+b.emergency+b.investment};
}
function distribution(m=month()){const b=m.budget;return [['Hogar',b.groceries+b.services],['IESS',b.iess1+b.iess2],['Moto',b.gas+b.maintenance],['Ahorro',b.rent+b.emergency+b.investment],['Metas',sum(Object.values(b.goals))],['Personal',b.personal1+b.personal2]];}
function health(t){if(month().incomeMode==='daily'&&month().status!=='closed'&&t.available<0)return {class:'warn',label:t.income?'Plan mensual por cubrir':'Ingresos por registrar',text:'Faltan '+money(-t.available)+' para cubrir el presupuesto del mes. Cada ingreso diario actualiza este avance.',icon:'calendar'};if(t.available<0)return {class:'danger',label:'Presupuesto excedido',text:'Tu presupuesto supera tus ingresos en '+money(-t.available)+'. Reduce gastos variables o ajusta temporalmente una meta.',icon:'alert'};if(!t.income||t.available<t.income*.05)return {class:'warn',label:'Presupuesto ajustado',text:'Quedan '+money(t.available)+' sin asignar. Mantengamos un poco de margen para imprevistos.',icon:'alert'};return {class:'',label:'Presupuesto saludable',text:'Tienen '+money(t.available)+' disponibles para dar el siguiente paso juntos.',icon:'check'};}
function assert(condition,msg){if(!condition)throw Error(msg);}
function validateFundTimeline(s){
 const b=Object.fromEntries(allFunds(s).map(f=>[f,openingFund(f,s)]));
 const list=s.transactions.map((t,i)=>({...t,order:i})).sort((a,b)=>a.date.localeCompare(b.date)||a.order-b.order);
 for(const t of list){if(t.type==='saving')b[t.to]+=t.amount;if(t.type==='transfer'){b[t.from]-=t.amount;b[t.to]+=t.amount;}if(t.type==='expense'&&t.from)b[t.from]-=t.amount;if(t.from&&b[t.from]<0)throw Error('El fondo de origen no tiene saldo suficiente en la fecha '+dateName(t.date)+'. Registra primero el aporte correspondiente.');}
}
/* Validate the whole backup before it can replace any existing data. */
function validateState(s){
 const obj=x=>x&&typeof x==='object'&&!Array.isArray(x);
 const validMoney=x=>Number.isSafeInteger(x)&&x>=0&&x<=MAX_MONEY;
 const textOk=(x,max=120)=>typeof x==='string'&&x.trim().length>0&&x.length<=max;
 assert(obj(s)&&[1,VERSION].includes(s.version),'Este archivo no es una copia compatible de Nuestro Presupuesto.');
 assert(obj(s.settings)&&Array.isArray(s.settings.names)&&s.settings.names.length===2&&s.settings.names.every(n=>textOk(n,60)),'Los nombres de la copia no son válidos.');
 assert(textOk(s.settings.couple,80)&&['es','us'].includes(s.settings.format)&&['light','dark'].includes(s.settings.theme)&&validMoney(s.settings.limit)&&typeof s.settings.sameIess==='boolean'&&typeof s.settings.autoRedirect==='boolean','La configuración de la copia no es válida.');
 assert(Array.isArray(s.goals)&&s.goals.length<=500,'La lista de metas no es válida.');
 const ids=new Set();
 for(const g of s.goals){assert(obj(g)&&textOk(g.id,80)&&/^[a-zA-Z0-9_-]+$/.test(g.id)&&!ids.has(g.id)&&textOk(g.name)&&validMoney(g.target)&&g.target>0&&validMoney(g.initial)&&validMoney(g.monthly)&&validDate(g.due)&&validMonth(g.start)&&g.start<=g.due.slice(0,7),'Hay una meta inválida o duplicada en la copia.');ids.add(g.id);}
 assert(obj(s.initialFunds)&&fundKeys.every(k=>validMoney(s.initialFunds[k])),'Los saldos iniciales no son válidos.');
 assert(obj(s.months)&&Object.keys(s.months).length>0&&Object.keys(s.months).length<=2400,'Los meses de la copia no son válidos.');
 for(const[k,m]of Object.entries(s.months)){if(s.version===VERSION)assert(['daily','fixed'].includes(m.incomeMode),'Modo de ingreso inválido.');assert(validMonth(k)&&obj(m)&&m.key===k&&['planned','active','closed'].includes(m.status)&&Array.isArray(m.income)&&m.income.length===2&&m.income.every(validMoney)&&validMoney(m.extra)&&typeof m.stable==='boolean','Hay un mes inválido en la copia.');assert(obj(m.budget)&&[...expenseKeys,'rent','emergency','investment','personal1','personal2'].every(f=>validMoney(m.budget[f]))&&obj(m.budget.goals)&&Object.entries(m.budget.goals).every(([id,v])=>ids.has(id)&&validMoney(v)),'Hay un presupuesto inválido.');assert(Array.isArray(m.essentials)&&m.essentials.every(c=>expenseKeys.includes(c))&&new Set(m.essentials).size===m.essentials.length,'Las categorías esenciales no son válidas.');assert(m.status==='closed'?obj(m.closed)&&obj(m.closed.totals)&&typeof m.closed.at==='string':m.closed===null,'El estado del cierre no es válido.');if(m.closed)assert(Object.values(m.closed.totals).every(x=>Number.isSafeInteger(x)&&Math.abs(x)<=MAX_MONEY*100)&&validMoney(m.closed.patrimony),'El resumen del cierre no es válido.');}
 assert(validMonth(s.selectedMonth)&&Object.hasOwn(s.months,s.selectedMonth),'El mes seleccionado no existe.');
 assert(Array.isArray(s.transactions)&&s.transactions.length<=50000,'La lista de movimientos no es válida.');
 const funds=allFunds(s),txIds=new Set(),dailyDates=new Set();
 for(const t of s.transactions){assert(obj(t)&&textOk(t.id,150)&&!txIds.has(t.id)&&validDate(t.date)&&Object.hasOwn(s.months,t.date.slice(0,7))&&Object.hasOwn(typeNames,t.type)&&validMoney(t.amount)&&(t.amount>0||(s.version===VERSION&&isNeomar(t)))&&textOk(t.description,300)&&['1','2','both'].includes(t.person)&&['home','savings','personal1','personal2'].includes(t.account),'Hay un movimiento inválido o duplicado.');txIds.add(t.id);if(isNeomar(t)){assert(s.version===VERSION&&!dailyDates.has(t.date)&&t.person==='both'&&t.source==='manual'&&s.months[t.date.slice(0,7)].incomeMode==='daily'&&(t.note===undefined||(typeof t.note==='string'&&t.note.length<=240)),'Ingreso diario duplicado o inválido.');dailyDates.add(t.date);}assert(t.source==='manual'||t.source==='close','Origen de movimiento inválido.');if(t.source==='close')assert(s.months[t.date.slice(0,7)].status==='closed'&&t.type==='saving','Aporte automático sin cierre.');if(t.type==='income')assert(['bonus','additional','extra',...(s.version===VERSION?['neomar']:[])].includes(t.category)&&t.account==='home'&&!t.from&&!t.to,'Ingreso inválido.');if(t.type==='saving')assert(funds.includes(t.to)&&!t.from&&t.account==='savings'&&t.category===t.to,'Aporte inválido.');if(t.type==='transfer')assert(funds.includes(t.from)&&funds.includes(t.to)&&t.from!==t.to&&t.account==='savings'&&t.category===t.to,'Transferencia inválida.');if(t.type==='expense'){assert(!t.to,'Gasto inválido.');if(t.from)assert(funds.includes(t.from)&&t.account==='savings'&&t.category===t.from,'Retiro de fondo inválido.');else assert(['groceries','services','iess1','iess2','gas','personal1','personal2','other'].includes(t.category)&&((t.account==='home'&&!t.category.startsWith('personal'))||(t.account===t.category&&t.category.startsWith('personal'))),'Categoría o cuenta de gasto inválida.');}if(t.subtype)assert(['Supermercado','Limpieza','Hogar','Otros'].includes(t.subtype),'Tipo de compra inválido.');}
 assert(Array.isArray(s.equipment)&&s.equipment.length<=100&&s.equipment.every(e=>obj(e)&&textOk(e.id,80)&&/^[a-zA-Z0-9_-]+$/.test(e.id)&&textOk(e.name)&&validMoney(e.dec)&&validMoney(e.jan))&&new Set(s.equipment.map(e=>e.id)).size===s.equipment.length,'La distribución del hogar no es válida.');
 assert(s.updatedAt===null||(typeof s.updatedAt==='string'&&Number.isFinite(Date.parse(s.updatedAt))),'Fecha de actualización inválida.');
 validateFundTimeline(s);
 for(const[k,m]of Object.entries(s.months))if(m.redirected!=null){const r=m.redirected;assert(obj(r)&&validMoney(r.fromBefore)&&validMoney(r.toBefore)&&validMonth(r.triggerMonth)&&r.triggerMonth<k&&Object.hasOwn(s.months,r.triggerMonth),'El registro de redirección automática no es válido.');}
 const totalKeys=['income','extraRecorded','expenses','savings','personal','planned','over','available','plannedAvailable','spent','funded','essential','goals','regularSavings'];
 for(const[k,m]of Object.entries(s.months))if(m.status==='closed'){
  assert(Number.isFinite(Date.parse(m.closed.at))&&totalKeys.every(f=>Number.isSafeInteger(m.closed.totals[f])),'El resumen del cierre está incompleto o tiene una fecha inválida.');
  const expected=totals(k,s);
  assert(totalKeys.every(f=>expected[f]===m.closed.totals[f])&&m.closed.patrimony===sum(Object.values(balances(s,k))),'El cierre no coincide con el presupuesto y sus movimientos.');
 }
 return s;
}
function loadState(){
 let raw,loaded;
 try{raw=localStorage.getItem(APP_KEY);if(!raw)return initialState();loaded=validateState(JSON.parse(raw));}
 catch(e){storageProblem='No se pudo recuperar el guardado: '+e.message+' Se abrió una sesión nueva sin sobrescribir el original. Exporta tus datos antes de continuar.';return initialState();}
 if(loaded.version===VERSION)return loaded;
 // A failed storage write must never discard a successfully loaded history.
 let updated;
 try{updated=migrateState(loaded);}catch(e){storageProblem='Se conservó tu historial anterior, pero no se pudo actualizar su formato. Exporta una copia antes de continuar.';return loaded;}
 try{if(!localStorage.getItem(APP_KEY+'-antes-ingresos-diarios'))localStorage.setItem(APP_KEY+'-antes-ingresos-diarios',raw);localStorage.setItem(APP_KEY,JSON.stringify(updated));}
 catch(e){storageProblem='Tu historial se recuperó completo, pero el navegador no permitió guardar la actualización. Exporta una copia JSON antes de salir.';}
 return updated;
}
function save(){
 state.updatedAt=new Date().toISOString();
 if(storageProblem){showStorageWarning();return false;}
 try{localStorage.setItem(APP_KEY,JSON.stringify(state));return true;}
 catch(e){storageProblem='El navegador no permite guardar los cambios. Esta sesión sigue funcionando; exporta una copia JSON antes de salir.';showStorageWarning();return false;}
}
function showStorageWarning(){const el=$('#storage-alert');el.className=storageProblem?'storage-alert':'';el.textContent=storageProblem;}
function commit(change,message){const before=clone(state);try{change();reconcileRedirects();validateFundTimeline(state);save();render();if(message)toast(message);}catch(e){state=before;throw e;}}
function ensureOpen(k=state.selectedMonth){assert(month(k),'Primero crea el mes de este movimiento.');assert(month(k).status!=='closed','Este mes está cerrado. Reábrelo desde Mes a mes antes de hacer cambios.');assert(!Object.keys(state.months).some(key=>key>k&&month(key).status==='closed'),'Hay un mes posterior cerrado. Reábrelo primero para conservar un historial coherente.');}
function addTransaction(t){const k=t.date.slice(0,7);ensureOpen(k);state.transactions.push(t);validateFundTimeline(state);redirectFinishedGoal(k);}
function reconcileRedirects(){
 const g=goal('furniture');
 for(const m of Object.values(state.months)){
  const r=m.redirected;if(!r||m.status==='closed')continue;
  if(!g||goalProgress(g,state,r.triggerMonth).remaining>0){
   // Restore only the exact automatic result; respect later manual adjustments.
   if(m.budget.goals.furniture===0&&m.budget.goals.equipment===r.toBefore+r.fromBefore){m.budget.goals.furniture=r.fromBefore;m.budget.goals.equipment=r.toBefore;}
   m.redirected=null;
  }
 }
}
function redirectFinishedGoal(effectiveMonth=state.selectedMonth){
 reconcileRedirects();
 if(!state.settings.autoRedirect)return;
 const g=goal('furniture'),dest=goal('equipment');if(!g||!dest||goalProgress(g,state,effectiveMonth).remaining>0)return;
 for(const[k,m]of Object.entries(state.months)){if(m.status==='closed'||k<=effectiveMonth||k>dest.due.slice(0,7))continue;const amount=m.budget.goals.furniture||0;if(amount){m.redirected={fromBefore:amount,toBefore:m.budget.goals.equipment||0,triggerMonth:effectiveMonth};m.budget.goals.furniture=0;m.budget.goals.equipment=(m.budget.goals.equipment||0)+amount;}}
}
function closeMonth(k,completeFunds=true){
 const m=month(k);if(m.status==='closed')return;ensureOpen(k);
 const allocations=completeFunds?planFunds(m):{};
 if(completeFunds&&m.incomeMode==='daily')assert(totals(k).available>=0,'El ingreso real no alcanza para financiar el plan. Cierra solo con los aportes registrados o ajusta el presupuesto.');
 for(const[f,planned]of Object.entries(allocations)){const needed=Math.max(0,planned-savingsContributed(k,f));if(needed)state.transactions.push({id:'close:'+k+':'+f,date:lastDate(k),type:'saving',amount:needed,category:f,to:f,from:null,description:'Reserva de cierre · '+fundName(f),person:'both',account:'savings',source:'close'});}
 m.status='closed';m.closed={at:new Date().toISOString(),totals:totals(k),patrimony:sum(Object.values(balances(state,k)))};redirectFinishedGoal(k);
}
function reopenMonth(k){assert(!Object.keys(state.months).some(key=>key>k&&month(key).status==='closed'),'Reabre primero los meses cerrados posteriores, empezando por el más reciente.');const m=month(k);state.transactions=state.transactions.filter(t=>!(t.source==='close'&&t.date.startsWith(k)));m.status='active';m.closed=null;validateFundTimeline(state);reconcileRedirects();}
function toast(message,error=false){const region=$('#toast-region');while(region.children.length>=2)region.firstElementChild.remove();const div=document.createElement('div');div.className='toast'+(error?' error':'');div.textContent=message;region.appendChild(div);setTimeout(()=>div.remove(),5000);}
function download(text,filename,type){const url=URL.createObjectURL(new Blob([text],{type}));const a=document.createElement('a');a.href=url;a.download=filename;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),2000);}
function exportJSON(){download(JSON.stringify(state,null,2),'nuestro-presupuesto-'+today()+'.json','application/json');toast('Copia de seguridad descargada.');}
function exportCSV(){const safe=v=>{let s=String(v??'');if(/^[=+\-@\t\r]/.test(s))s="'"+s;return '"'+s.replace(/"/g,'""')+'"';};const rows=[['Fecha','Tipo','Categoría','Descripción','Monto USD','Persona','Cuenta','Origen','Destino'],...filteredTransactions().map(t=>[t.date,typeNames[t.type],categoryName(t.category),t.description,amountInput(t.amount),personName(t.person),accountName(t.account),t.from?fundName(t.from):'',t.to?fundName(t.to):''])];download('\ufeff'+rows.map(r=>r.map(safe).join(';')).join('\r\n'),'movimientos-'+state.selectedMonth+'.csv','text/csv;charset=utf-8');toast('CSV descargado con los filtros actuales.');}
const icons={home:'M3 10 12 3l9 7v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1ZM9 21v-8h6v8',wallet:'M4 5h15v4M4 5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h17V8H4M21 12h-6v5h6',arrows:'M4 7h15m-4-4 4 4-4 4M20 17H5m4-4-4 4 4 4',target:'M12 3a9 9 0 1 0 9 9M12 7a5 5 0 1 0 5 5M12 12l9-9m-5 0h5v5',cart:'m3 3 2 2 3 12h10l3-9H6M9 21h.01M18 21h.01',bike:'M7 17a4 4 0 1 1-4-4 4 4 0 0 1 4 4Zm14 0a4 4 0 1 1-4-4 4 4 0 0 1 4 4ZM3 17l5-9h6l3 9M8 8l6 9H3M7 4h4m2 0h3l2 4',leaf:'M20 3C8 2 2 8 5 16c8 7 17-1 15-13ZM5 20 15 9',sliders:'M4 6h5m4 0h7M4 12h9m4 0h3M4 18h2m4 0h10M9 3v6m4 0v6M6 15v6',calendar:'M5 4h14a2 2 0 0 1 2 2v14H3V6a2 2 0 0 1 2-2Zm2-2v5M17 2v5M3 10h18M7 14h2m3 0h2m3 0h1M7 17h2m3 0h2',settings:'M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8ZM10 2h4l1 3 3 1 3-1 2 4-2 2v3l2 2-2 4-3-1-3 1-1 3h-4l-1-3-3-1-3 1-2-4 2-2v-3L1 9l2-4 3 1 3-1Z',plus:'M12 5v14M5 12h14',down:'M12 4v14m-5-5 5 5 5-5M4 21h16',up:'M12 20V6m-5 5 5-5 5 5',right:'M5 12h14m-5-5 5 5-5 5',left:'m14 6-6 6 6 6',chevron:'m9 6 6 6-6 6',check:'m5 12 4 4L19 6',alert:'m12 3 10 18H2Zm0 5v5m0 4v.1',shield:'m12 3 8 3v6c0 5-8 9-8 9s-8-4-8-9V6ZM8 12l3 3 5-6',moon:'M20 15A9 9 0 0 1 9 3a9 9 0 1 0 11 12Z',sun:'M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8ZM12 2v2m0 16v2M2 12h2m16 0h2M5 5l1 1m12 12 1 1M5 19l1-1M18 6l1-1',print:'M6 9V3h12v6M6 18H3V9h18v9h-3M6 14h12v7H6Z',close:'m6 6 12 12M18 6 6 18',trash:'M4 6h16M9 6V3h6v3M6 6l1 15h10l1-15M10 10v7m4-7v7',edit:'m4 16 12-12 4 4L8 20H4Zm9-9 4 4',copy:'M8 7h12v14H8ZM16 7V3H3v14h5',menu:'M4 6h16M4 12h16M4 18h16',heart:'M12 21 3 12C-3 3 9-2 12 6 15-2 27 3 21 12Z',info:'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Zm0 8v6m0-10v.1',sofa:'M5 12V6h14v6M3 11h3v5h12v-5h3v9H3ZM5 20v2m14-2v2',lock:'M5 10h14v11H5ZM8 10V6a4 4 0 0 1 8 0v4M12 14v3',chart:'M4 3v18h17M8 16v-5m5 5V6m5 10v-8'};
function icon(name,size=19){return '<svg width="'+size+'" height="'+size+'" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="'+(icons[name]||icons.wallet)+'"/></svg>';}
function button(label,action,style='secondary',ic='',attrs=''){return '<button type="button" class="btn '+style+'" data-action="'+action+'" '+attrs+'>'+(ic?icon(ic,17):'')+escapeHtml(label)+'</button>';}
function progress(value,color=''){return '<div class="progress '+color+'" role="progressbar" aria-valuenow="'+Math.round(Math.max(0,Math.min(100,value)))+'" aria-valuemin="0" aria-valuemax="100" aria-label="Progreso"><span style="width:'+Math.max(0,Math.min(100,value))+'%"></span></div>';}
function moneyInput(name,label,value,extra=''){return '<label>'+escapeHtml(label)+'<span class="input-money"><span>$</span><input type="number" min="0" max="1000000000" step="0.01" name="'+name+'" value="'+amountInput(value)+'" required '+extra+'></span></label>';}
function empty(title,text,action='',label=''){return '<div class="empty"><div class="tile-icon green">'+icon('leaf')+'</div><h3>'+escapeHtml(title)+'</h3><p>'+escapeHtml(text)+'</p>'+(action?button(label,action,'soft','plus'):'')+'</div>';}
function stat(label,value,note,ic,featured=false,negative=false){return '<article class="stat '+(featured?'featured ':'')+(negative?'negative-card':'')+'"><div class="stat-top"><span>'+label+'</span><span class="stat-icon">'+icon(ic,17)+'</span></div><div class="stat-number">'+money(value)+'</div><small>'+note+'</small></article>';}
function donut(data,centerLabel='Planificado'){const total=sum(data.map(d=>d[1]));let acc=0;const gradient=data.map((d,i)=>{const start=acc;acc+=total?d[1]/total*100:0;return colors[i%colors.length]+' '+start+'% '+acc+'%';}).join(',');return '<div class="donut-layout"><div class="donut" role="img" aria-label="Distribución: '+escapeHtml(data.map(d=>d[0]+' '+money(d[1])).join(', '))+'" style="background:'+(total?'conic-gradient('+gradient+')':'var(--line)')+'"><div class="donut-center"><small>'+centerLabel+'</small><strong>'+money(total)+'</strong></div></div><div class="legend">'+data.map((d,i)=>'<div class="legend-row"><span class="dot" style="background:'+colors[i%colors.length]+'"></span><span>'+d[0]+'</span><strong>'+money(d[1])+'</strong></div>').join('')+'</div></div>';}
function heading(title,description,actions=''){return '<div class="heading"><div><div class="eyebrow">'+escapeHtml(state.settings.couple)+' · '+monthName(state.selectedMonth)+'</div><h1>'+title+'</h1><p>'+description+'</p></div><div class="actions">'+actions+'</div></div>';}
function notice(text,type='',ic='info'){return '<div class="notice '+type+'">'+icon(ic,18)+'<span>'+text+'</span></div>';}
function detail(label,value,ic=''){return '<div class="detail-line"><span class="label">'+(ic?icon(ic,17):'')+label+'</span><strong>'+value+'</strong></div>';}
function closedNotice(){return month().status==='closed'?'<div class="section-space">'+notice('Este mes está cerrado. Su resumen está guardado; puedes reabrirlo desde Mes a mes.','','lock')+'</div>':'';}

/* Views are pure HTML renderers. All user-provided text is escaped. */
const navItems=[['home','Inicio','home'],['daily','Ingresos NEOMAR','down'],['budget','Presupuesto','wallet'],['transactions','Movimientos','arrows'],['goals','Metas del hogar','target'],['house','Compras del hogar','cart'],['bike','Mi moto','bike'],['savings','Ahorros','leaf'],['simulator','Simulador','sliders'],['history','Mes a mes','calendar'],['settings','Configuración','settings']];
function renderShell(){
 document.documentElement.dataset.theme=state.settings.theme;
 $('#sidebar').innerHTML='<div class="brand"><span class="brand-mark">'+icon('home',25)+'</span><div><strong>Nuestro<br>Presupuesto</strong><small>Un equipo. Un futuro.</small></div></div><div class="nav-caption">NUESTRO ESPACIO</div><nav class="nav">'+navItems.map(([id,name,ic])=>'<button class="'+(page===id?'active':'')+'" data-page="'+id+'" '+(page===id?'aria-current="page"':'')+'>'+icon(ic)+'<span>'+name+'</span></button>').join('')+'</nav><div class="sidebar-foot"><div class="privacy"><strong>'+icon('shield',15)+' Solo en este navegador</strong>Tus finanzas se guardan aquí.<br>Exporta una copia de vez en cuando.</div><div class="people"><span class="avatar">'+escapeHtml(state.settings.names[0].slice(0,1))+'</span><span class="avatar second">'+escapeHtml(state.settings.names[1].slice(0,1))+'</span><span>'+escapeHtml(state.settings.couple)+'</span></div></div>';
 const keys=Object.keys(state.months).sort(),index=keys.indexOf(state.selectedMonth);
 $('#topbar').innerHTML='<button class="icon-btn mobile-menu" data-action="menu" aria-label="Abrir menú">'+icon('menu')+'</button><span class="breadcrumb">'+icon('home',16)+escapeHtml(state.settings.couple)+'<span>/</span><strong>'+navItems.find(n=>n[0]===page)[1]+'</strong></span><div class="top-actions"><div class="month-control"><button class="icon-btn" data-action="previous-month" aria-label="Mes anterior" '+(index===0?'disabled':'')+'>'+icon('left',16)+'</button><select id="month-select" aria-label="Mes seleccionado">'+keys.map(k=>'<option value="'+k+'" '+(k===state.selectedMonth?'selected':'')+'>'+monthName(k)+'</option>').join('')+'</select><button class="icon-btn" data-action="next-month" aria-label="Mes siguiente" '+(index===keys.length-1?'disabled':'')+'>'+icon('chevron',16)+'</button></div><button class="icon-btn print-btn" data-action="print" aria-label="Imprimir o guardar PDF" title="Imprimir / Guardar PDF">'+icon('print',18)+'</button><button class="icon-btn" data-action="theme" aria-label="Cambiar a modo '+(state.settings.theme==='light'?'oscuro':'claro')+'" title="Cambiar apariencia">'+icon(state.settings.theme==='light'?'moon':'sun',18)+'</button></div>';
}
function render(){renderShell();const views={home:renderHome,daily:renderDaily,budget:renderBudget,transactions:renderTransactions,goals:renderGoals,house:renderHouse,bike:renderBike,savings:renderSavings,simulator:renderSimulator,history:renderHistory,settings:renderSettings};$('#main').innerHTML='<div class="fade-in">'+views[page]()+(page==='budget'?renderPersonalCards():'')+'</div><footer class="footer"><span>'+icon('heart',13)+' Finanzas, hogar y metas juntos</span><span>'+icon(storageProblem?'alert':'check',13)+(storageProblem?'Guardado no disponible':state.updatedAt?'Última actualización: '+new Date(state.updatedAt).toLocaleString('es-EC'):'Listos para empezar · datos iniciales editables')+'</span></footer>';showStorageWarning();}
function healthBar(t=totals()){const h=health(t);return '<div class="statusbar '+h.class+'"><div>'+icon(h.icon,18)+'<span><strong>'+h.label+'.</strong> '+h.text+'</span></div><span class="badge">'+statusNames[month().status]+'</span></div>';}
function goalPreview(g){const p=requiredContribution(g);return '<div class="goal-preview"><div class="goal-row"><span class="tile-icon '+(g.id==='equipment'?'green':'')+'">'+icon(g.id==='furniture'?'sofa':'home',21)+'</span><div><h3>'+escapeHtml(g.name)+'</h3><p>'+dateName(g.due)+'</p></div><span class="badge '+(p.remaining===0?'green':'yellow')+'">'+(p.remaining===0?'Completada':percent(p.pct))+'</span></div>'+progress(p.pct,g.id==='equipment'?'':'orange')+'<div class="progress-label"><span><strong>'+money(p.achieved)+'</strong> de '+money(g.target)+'</span><span>'+money(month().budget.goals[g.id]||0)+'/mes</span></div></div>';}
function renderHome(){
 const t=totals(),m=month(),b=balances(),grocery=spending(state.selectedMonth,'groceries');
 return heading('Construyamos nuestro futuro.','Un vistazo a nuestro dinero y a lo que viene.',button('Registrar ingreso del día','daily-income','','plus')+button('Movimiento','new-transaction','secondary','arrows'))+dailyHomeSummary()+healthBar(t)+
 '<section class="stats" aria-label="Resumen mensual">'+stat('Ingresos del mes',t.income,m.incomeMode==='daily'?'Ingresos diarios reales + otros registrados':'Cálculo mensual conservado','down')+stat('Gastos planificados',t.expenses,'Hogar, IESS y reservas de moto','wallet')+stat('Ahorro y metas',t.savings,'Aportes reservados para este mes','leaf')+stat('Disponible',t.available,'Después de reservas y excesos reales','arrows',true,t.available<0)+'</section>'+
 '<div class="grid dashboard-grid"><section class="card"><div class="card-head"><div><h2>Así se distribuye nuestro dinero</h2><p>Cada dólar tiene un propósito</p></div><button class="link-btn" data-page="budget">Ver plan '+icon('chevron',14)+'</button></div>'+donut(distribution())+'<div class="card-footer"><span>Dinero personal incluido</span><strong>'+money(t.personal)+' entre los dos</strong></div></section><section class="card"><div class="card-head"><div><h2>Un hogar, paso a paso</h2><p>Las metas que estamos construyendo</p></div><button class="link-btn" data-page="goals">Ver todas '+icon('chevron',14)+'</button></div>'+state.goals.slice(0,2).map(goalPreview).join('')+(state.goals.length===0?empty('Nuestra próxima meta','Una idea de hoy puede ser el hogar de mañana.','new-goal','Crear una meta'):'')+'</section></div>'+
 '<div class="grid cols3 section-space"><section class="card soft-card"><div class="goal-row"><span class="tile-icon green">'+icon('home')+'</span><h3>Renta que no pagamos</h3></div><div class="savings-number">'+money(b.rent)+'</div><p class="muted small">Acumulado real · '+money(m.budget.rent)+' previstos este mes</p><div class="divider"></div><div class="detail-line"><span class="small">En 12 meses, podríamos tener</span><strong>'+money(b.rent+m.budget.rent*12)+'</strong></div><button class="link-btn" data-page="savings">Construir patrimonio '+icon('right',15)+'</button></section><section class="card"><div class="goal-row"><span class="tile-icon blue">'+icon('shield')+'</span><h3>Un respaldo para los dos</h3></div><div class="savings-number">'+money(b.emergency)+'</div><p class="muted small">Fondo de emergencia · primer nivel '+money(100000)+'</p>'+progress(b.emergency/100000*100,'blue')+'<div class="progress-label"><span>'+percent(Math.min(100,b.emergency/100000*100))+' del primer nivel</span><span>Meta '+money(100000)+'</span></div><div class="section-space"><button class="link-btn" data-action="contribute" data-fund="emergency">Hacer un aporte '+icon('plus',15)+'</button></div></section><section class="card"><div class="card-head"><h2>Este mes</h2><span class="badge">Reservado</span></div>'+detail('Compras',money(m.budget.groceries),'cart')+detail('Moto',money(m.budget.gas+m.budget.maintenance),'bike')+detail('IESS',money(m.budget.iess1+m.budget.iess2),'shield')+detail('Dinero personal',money(t.personal),'wallet')+'</section></div>'+
 '<div class="grid cols2 section-space"><section class="card"><div class="card-head"><h2>Pequeños pasos, grandes avances</h2>'+icon('leaf')+'</div>'+recommendations(t,b,grocery)+'</section><section class="card"><div class="card-head"><h2>Últimos movimientos</h2><button class="link-btn" data-page="transactions">Ver todos '+icon('chevron',14)+'</button></div>'+compactTransactions(transactions().slice().reverse().slice(0,4))+'</section></div><div class="section-space">'+notice('<strong>El dinero del negocio debe mantenerse separado de las finanzas personales.</strong> Aquí administramos solamente los sueldos y los ingresos personales que recibimos.','','info')+'</div>';
}
function recommendations(t,b,grocery){let list='';const item=(ic,title,desc,action='')=>'<div class="recommendation"><span class="tile-icon green">'+icon(ic,18)+'</span><div><h3>'+title+'</h3><p>'+desc+'</p>'+action+'</div></div>';if(t.available<0)list+=item('alert','Recuperemos el equilibrio','Debes reducir '+money(-t.available)+' del presupuesto para mantenerlo equilibrado.');else if(t.available>0)list+=item('leaf','Tenemos '+money(t.available)+' sin asignar','Podemos darle un destino y acercarnos a nuestras metas.','<div class="actions" style="margin-top:10px">'+button('Enviar a emergencia','allocate','soft sm','','data-fund="emergency"')+button('Enviar a renta','allocate','secondary sm','','data-fund="rent"')+'</div>');if(b.emergency<100000)list+=item('shield','Un poco de tranquilidad','Tu siguiente prioridad debería ser fortalecer el fondo de emergencia.');if(grocery>month().budget.groceries)list+=item('cart','Revisemos las compras','Este mes las compras superaron el presupuesto en '+money(grocery-month().budget.groceries)+'.');for(const id of ['furniture','equipment']){const g=goal(id);if(g&&goalProgress(g).remaining===0)list+=item('check','¡'+escapeHtml(g.name)+' completada!',id==='furniture'?'Puedes redirigir este aporte a Equipar nuestro hogar.':'Puedes redirigir este dinero a emergencia o a nuevas metas.',button('Revisar metas','view-goals','soft sm'));}return list||item('check','Vamos por buen camino','Sigue registrando los movimientos para mantener todo al día.');}
function compactTransactions(list){return list.length?list.map(t=>'<div class="detail-line"><span class="label"><span class="tile-icon '+(t.type==='income'?'blue':'green')+'" style="width:33px;height:33px">'+icon(t.type==='income'?'down':t.type==='expense'?'up':'arrows',16)+'</span><span>'+escapeHtml(t.description)+'<br><small class="muted">'+dateName(t.date)+' · '+escapeHtml(categoryName(t.category))+'</small></span></span><strong class="'+(t.type==='income'?'positive':'')+'">'+(t.type==='expense'?'−':'')+money(t.amount)+'</strong></div>').join(''):empty('Todo empieza con un primer movimiento','Registra una compra, un ingreso extra o un aporte.','new-transaction','Registrar movimiento');}
function budgetRow(key,label,note='',value=month().budget[key]){return '<div class="form-row"><label for="budget-'+key+'">'+escapeHtml(label)+(note?'<small>'+note+'</small>':'')+'</label><input id="budget-'+key+'" name="'+key+'" aria-label="'+escapeHtml(label)+'" type="number" min="0" step="0.01" max="1000000000" value="'+amountInput(value)+'" required></div>';}
function budgetSummary(t=totals()){return '<h2>Todo en su lugar</h2><p class="muted small" style="margin-top:6px">Disponible tras cubrir cada reserva.</p><div class="divider"></div>'+detail('Ingresos',money(t.income))+detail('Hogar, IESS y moto',money(t.expenses))+detail('Ahorro y metas',money(t.savings))+detail('Dinero personal',money(t.personal))+(t.over?detail('Excesos registrados',money(t.over)):'')+'<div class="divider"></div><p class="muted small">Disponible</p><div class="money-big '+(t.available<0?'negative':'positive')+'">'+money(t.available)+'</div><div class="section-space">'+notice(t.available<0?'Debes reducir '+money(-t.available)+' para equilibrar el mes.':'Tienes '+money(t.available)+' sin asignar.',t.available<0?'error':'success')+'</div>';}
function renderBudget(){const m=month(),b=m.budget;return heading('Un plan para nuestro dinero.','Edita el presupuesto de este mes. Los meses cerrados conservan sus cifras.',button('Copiar mes anterior','copy-month','secondary','copy'))+closedNotice()+'<div class="form-layout section-space"><form id="budget-form" class="card"><div class="form-section"><div class="card-head"><h2>01 · Lo que recibimos</h2><span class="badge green">Ingresos</span></div>'+(m.incomeMode==='daily'?dailyBudgetIncome():budgetRow('income1',state.settings.names[0],'Sueldo mensual conservado',m.income[0])+budgetRow('income2',state.settings.names[1],'Sueldo mensual conservado',m.income[1])+budgetRow('extra','Ingresos extra planificados','Historial anterior al registro diario.',m.extra))+'</div><div class="form-section"><h2>02 · Hogar y obligaciones</h2>'+budgetRow('groceries','Supermercado y compras',money(b.groceries/2)+' por quincena · '+money(Math.round(b.groceries*12/52))+' por semana')+budgetRow('services','Servicios y hogar')+budgetRow('iess1','IESS · '+state.settings.names[0],'Aporte mensual editable, sin cálculo de tasas.')+budgetRow('iess2','IESS · '+state.settings.names[1],state.settings.sameIess?'Se igualará al primer aporte al guardar.':'Aporte independiente.')+budgetRow('gas','Gasolina de la moto',money(Math.round(b.gas*12/52))+' semanales, usando 52 semanas / 12 meses.')+budgetRow('maintenance','Reserva de mantenimiento','Se acumula en un fondo y no se pierde al terminar el mes.')+'</div><div class="form-section"><h2>03 · Nuestro futuro</h2>'+budgetRow('rent','Renta que no pagamos','Reservada; nunca se cuenta como dinero disponible para compras.')+budgetRow('emergency','Fondo de emergencia')+budgetRow('investment','Metas / inversión')+state.goals.map(g=>budgetRow('goal_'+g.id,g.name,'Objetivo: '+money(g.target),b.goals[g.id]||0)).join('')+'</div><div class="form-section"><h2>04 · Espacio para cada uno</h2>'+budgetRow('personal1',state.settings.names[0])+budgetRow('personal2',state.settings.names[1])+'<p class="field-note">El dinero personal pertenece a cada integrante y puede utilizarse libremente. No necesita justificarse ante el hogar.</p></div><div class="form-error" role="alert"></div><div class="actions section-space"><button class="btn" type="submit" '+(m.status==='closed'?'disabled':'')+'>'+icon('check',17)+' Guardar presupuesto</button>'+button('Restablecer mes','reset-month','secondary')+'</div></form><aside class="sticky"><section class="card" id="budget-summary">'+budgetSummary()+'</section><section class="card section-space"><h2>Presupuesto estable</h2><p class="muted small" style="margin:7px 0 15px">Para la etapa que empieza en febrero de 2027.</p>'+stableDonut()+'<div class="section-space">'+button(m.stable?'Reaplicar plan estable':'Activar plan estable','stable-plan','soft','leaf')+'</div><p class="field-note">La propuesta se adapta al ingreso de este mes. Revisa los importes antes de aplicarla.</p></section></aside></div>';}
function stableAmounts(){const total=totals().income;const household=Math.round(total*.4),emergency=Math.round(total*.2),rent=Math.round(total*.1),investment=Math.round(total*.1);return {household,emergency,rent,investment,personal:total-household-emergency-rent-investment};}
function stableDonut(){const a=stableAmounts();return donut([['Hogar · 40%',a.household],['Emergencia · 20%',a.emergency],['Renta · 10%',a.rent],['Metas · 10%',a.investment],['Personal · 20%',a.personal]],'Plan sugerido');}
function filteredTransactions(){const f=transactionFilters,k=f.month==='current'?state.selectedMonth:f.month;return state.transactions.filter(t=>(!k||t.date.startsWith(k))&&(!f.type||t.type===f.type)&&(!f.category||t.category===f.category)&&(!f.person||t.person===f.person)).slice().sort((a,b)=>b.date.localeCompare(a.date));}
function selectOptions(items,selected){return items.map(([value,label])=>'<option value="'+escapeHtml(value)+'" '+(value===selected?'selected':'')+'>'+escapeHtml(label)+'</option>').join('');}
function categoryOptions(){return [...Object.entries(categoryNames),...state.goals.map(g=>['goal:'+g.id,g.name])].map(([id])=>[id,categoryName(id)]);}
function transactionsTable(list,allowDelete=true){if(!list.length)return empty('Aún no hay movimientos','Los registros que coincidan con este mes y estos filtros aparecerán aquí.','new-transaction','Nuevo movimiento');return '<div class="table-scroll"><table><thead><tr><th>Fecha</th><th>Movimiento</th><th>Persona / cuenta</th><th>Tipo</th><th class="right">Monto</th>'+(allowDelete?'<th><span class="sr-only">Acciones</span></th>':'')+'</tr></thead><tbody>'+list.map(t=>'<tr><td class="nowrap">'+dateName(t.date)+'</td><td class="table-desc">'+escapeHtml(t.description)+'<span class="sub">'+escapeHtml(categoryName(t.category))+(t.subtype?' · '+t.subtype:'')+(t.type==='transfer'?' · desde '+escapeHtml(fundName(t.from)):'')+'</span></td><td>'+escapeHtml(personName(t.person))+'<span class="sub">'+escapeHtml(accountName(t.account))+'</span></td><td><span class="badge '+(t.type==='income'?'green':t.type==='expense'?'':'yellow')+'">'+typeNames[t.type]+'</span>'+(t.source==='close'?'<span class="sub">Cierre automático</span>':'')+'</td><td class="right nowrap numeric">'+(t.type==='expense'?'−':'')+money(t.amount)+'</td>'+(allowDelete?'<td class="right">'+(t.source!=='close'&&month(t.date.slice(0,7)).status!=='closed'?'<button class="icon-btn" aria-label="Eliminar '+escapeHtml(t.description)+'" title="Eliminar movimiento" data-action="delete-transaction" data-id="'+escapeHtml(t.id)+'">'+icon('trash',16)+'</button>':icon('lock',15))+'</td>':'')+'</tr>').join('')+'</tbody></table></div>';}
function renderTransactions(){const tx=filteredTransactions(),f=transactionFilters;return heading('La historia de nuestro dinero.','Una sola lista para ingresos diarios, extras, gastos, aportes y transferencias.',button('Exportar CSV','export-csv','secondary','down')+button('Nuevo movimiento','new-transaction','','plus'))+'<section class="card"><div class="filters"><label>Mes<select data-filter="month">'+selectOptions([['current','Mes seleccionado'],['','Todos los meses'],...Object.keys(state.months).sort().map(k=>[k,monthName(k)])],f.month)+'</select></label><label>Categoría<select data-filter="category">'+selectOptions([['','Todas las categorías'],...categoryOptions()],f.category)+'</select></label><label>Persona<select data-filter="person">'+selectOptions([['','Todas'],['1',state.settings.names[0]],['2',state.settings.names[1]],['both','Ambos']],f.person)+'</select></label><label>Tipo<select data-filter="type">'+selectOptions([['','Todos'],...Object.entries(typeNames)],f.type)+'</select></label></div>'+transactionsTable(tx)+'<div class="card-footer"><span>'+tx.length+' movimientos</span><span>Ingresos '+money(sum(tx.filter(t=>t.type==='income').map(t=>t.amount)))+' · Gastos '+money(sum(tx.filter(t=>t.type==='expense').map(t=>t.amount)))+'</span></div></section><div class="section-space">'+notice('Los ingresos diarios de NEOMAR aparecen aquí una sola vez. Edítalos desde Ingresos NEOMAR. Registra otros ingresos como bonos o extraordinarios; las transferencias no crean ingresos.')+'</div>';}
function renderGoals(){return heading('Hagamos espacio para los sueños.','Cada aporte nos acerca a la vida que queremos construir.',button('Nueva meta','new-goal','','plus'))+'<div class="grid cols2">'+state.goals.map(g=>{const p=requiredContribution(g);return '<article class="card goal-card"><div class="card-head"><span class="tile-icon '+(g.id==='furniture'?'':'green')+'">'+icon(g.id==='furniture'?'sofa':'target',24)+'</span><span class="badge '+(p.remaining===0?'green':'yellow')+'">'+(p.remaining===0?'Meta completada':p.months?monthName(g.due.slice(0,7)):'Plazo vencido')+'</span></div><h2>'+escapeHtml(g.name)+'</h2><div class="savings-number">'+money(p.achieved)+' <span class="muted" style="font-size:1rem;font-weight:400">/ '+money(g.target)+'</span></div>'+progress(p.pct,g.id==='furniture'?'orange':'')+'<div class="progress-label"><span>'+percent(p.pct)+' completado</span><span>Faltan '+money(p.remaining)+'</span></div><dl class="goal-detail"><div><dt>Saldo disponible en el fondo</dt><dd>'+money(p.balance)+'</dd></div><div><dt>Compras pagadas con el fondo</dt><dd>'+money(p.spent)+'</dd></div><div><dt>Meses para aportar</dt><dd>'+p.months+' · hasta '+dateName(g.due)+'</dd></div><div><dt>Aporte mensual necesario</dt><dd>'+(p.required===null?'Plazo vencido':money(p.required))+'</dd></div><div><dt>Reservado este mes</dt><dd>'+money(month().budget.goals[g.id]||0)+'</dd></div><div><dt>Aporte mensual habitual</dt><dd>'+money(g.monthly)+'</dd></div></dl><div class="actions">'+button('Agregar aporte','contribute','soft','plus','data-fund="goal:'+g.id+'"')+button('Editar','edit-goal','secondary sm','edit','data-id="'+g.id+'"')+button('Eliminar','delete-goal','secondary sm','trash','data-id="'+g.id+'"')+'</div>'+(g.id==='furniture'&&p.remaining===0?'<div class="section-space">'+button('Redirigir aporte a equipar el hogar','redirect-goal','soft sm')+'</div>':'')+'</article>';}).join('')+'</div>'+(state.goals.length===0?'<section class="card">'+empty('Una nueva meta empieza aquí','Define un monto, una fecha y un aporte mensual.','new-goal','Crear meta')+'</section>':'')+'<section class="card section-space"><div class="card-head"><div><h2>Equipar nuestro hogar</h2><p>Diciembre 2026 y enero 2027 · distribución sugerida, editable</p></div></div><form id="equipment-form"><div class="table-scroll"><table class="equipment-table"><thead><tr><th>Lo que queremos para casa</th><th>Diciembre</th><th>Enero</th></tr></thead><tbody>'+state.equipment.map(e=>'<tr><td>'+escapeHtml(e.name)+'</td><td><input aria-label="'+escapeHtml(e.name)+' diciembre" type="number" step="0.01" min="0" max="1000000000" name="dec_'+e.id+'" value="'+amountInput(e.dec)+'" required></td><td><input aria-label="'+escapeHtml(e.name)+' enero" type="number" step="0.01" min="0" max="1000000000" name="jan_'+e.id+'" value="'+amountInput(e.jan)+'" required></td></tr>').join('')+'</tbody><tfoot><tr><td><strong>Total sugerido</strong></td><td id="equipment-dec">'+money(sum(state.equipment.map(e=>e.dec)))+'</td><td id="equipment-jan">'+money(sum(state.equipment.map(e=>e.jan)))+'</td></tr></tfoot></table></div><p class="field-note">Esta lista distribuye las compras deseadas. El aporte al fondo se cambia en Presupuesto; las compras reales se registran como gastos desde el fondo de la meta.</p><div class="form-error" role="alert"></div><div class="actions section-space"><button class="btn" type="submit">Guardar distribución</button>'+button('Registrar compra con un fondo','fund-expense','secondary','cart')+'</div></form></section>';}
function groceryStatus(spent,budget){const pct=budget?spent/budget*100:spent?101:0;if(pct>100)return {pct,type:'error',text:'Este mes las compras superaron el presupuesto en '+money(spent-budget)+'.'};if(pct===100)return {pct,type:'error',text:'Has utilizado el 100% del presupuesto de compras.'};if(pct>=90)return {pct,type:'warning',text:'Ya utilizaste al menos el 90%. Quedan '+money(budget-spent)+'.'};if(pct>=75)return {pct,type:'warning',text:'Ya utilizaste al menos el 75%. Planifica las compras que faltan.'};return {pct,type:'success',text:'Todavía tienes '+money(budget-spent)+' para las compras del mes.'};}
function renderHouse(){const m=month(),spent=spending(state.selectedMonth,'groceries'),status=groceryStatus(spent,m.budget.groceries),list=transactions().filter(t=>t.type==='expense'&&!t.from&&t.category==='groceries');return heading('Lo que hace de esta casa un hogar.','Compras claras, sin perder de vista el presupuesto.',button('Registrar compra','new-purchase','','plus'))+'<section class="stats">'+stat('Presupuesto mensual',m.budget.groceries,'Para supermercado, limpieza y hogar','cart')+stat('Gastado este mes',spent,list.length+' compras registradas','up')+stat('Queda para compras',m.budget.groceries-spent,'Dentro de la reserva mensual','wallet',true,spent>m.budget.groceries)+stat('Por quincena',Math.round(m.budget.groceries/2),money(Math.round(m.budget.groceries*12/52))+' por semana aproximadamente','calendar')+'</section><section class="card"><div class="card-head"><h2>Vamos a nuestro ritmo</h2><strong>'+percent(status.pct)+' utilizado</strong></div>'+progress(status.pct,spent>m.budget.groceries?'red':status.pct>=75?'orange':'')+'<div class="section-space">'+notice(status.text,status.type,status.type==='success'?'check':'alert')+'</div></section><div class="grid cols2 section-space"><section class="card"><div class="card-head"><h2>Obligaciones del hogar</h2><button class="link-btn" data-page="budget">Editar '+icon('edit',14)+'</button></div>'+detail('Servicios y hogar',money(m.budget.services))+detail('IESS · '+escapeHtml(state.settings.names[0]),money(m.budget.iess1))+detail('IESS · '+escapeHtml(state.settings.names[1]),money(m.budget.iess2))+detail('Total IESS',money(m.budget.iess1+m.budget.iess2))+'</section><section class="card"><h2>Gastos reales por categoría</h2>'+spendingBars()+'</section></div><section class="card section-space"><div class="card-head"><h2>Nuestras compras</h2><span class="badge">'+list.length+' registros</span></div>'+transactionsTable(list.slice().reverse())+'</section><div class="section-space">'+notice('Las compras con dinero conjunto superiores a '+money(state.settings.limit)+' deberían conversarse antes.','','heart')+'</div>';}
function spendingBars(){const categories=['groceries','services','gas','iess1','iess2','other'];const entries=categories.map(c=>[categoryName(c),spending(state.selectedMonth,c)]);const max=Math.max(1,...entries.map(e=>e[1]));return entries.map(([label,value])=>'<div class="chart-bar"><span>'+escapeHtml(label)+'</span>'+progress(value/max*100,'blue')+'<strong>'+money(value)+'</strong></div>').join('');}
function renderBike(){const m=month(),balance=balances().maintenance,gasSpent=spending(state.selectedMonth,'gas');const list=state.transactions.filter(t=>(t.category==='maintenance'||t.category==='gas')&&t.date.startsWith(state.selectedMonth));return heading('Dos ruedas, todo en orden.','La gasolina del mes y un fondo que nos acompaña en el camino.',button('Registrar mantenimiento','maintenance-expense','','plus'))+'<div class="grid cols2"><section class="card"><div class="goal-row"><span class="tile-icon blue">'+icon('bike',24)+'</span><h2>Gasolina</h2></div><div class="savings-number">'+money(m.budget.gas)+' <span class="small muted">/ mes</span></div><p class="muted small">Equivale a '+money(Math.round(m.budget.gas*12/52))+' por semana.</p><div class="divider"></div>'+detail('Gastado este mes',money(gasSpent))+detail('Disponible para gasolina',money(m.budget.gas-gasSpent))+'<form id="gas-form" class="section-space"><div class="field-grid">'+moneyInput('weekly','Presupuesto semanal',Math.round(m.budget.gas*12/52))+'<div style="align-self:end"><button class="btn secondary" type="submit">Actualizar</button></div></div><p class="field-note">Equivalente mensual = semanal × 52 ÷ 12. $15 por semana son $65 al mes.</p><div class="form-error" role="alert"></div></form><div class="section-space">'+button('Registrar gasolina','gas-expense','soft','plus')+'</div></section><section class="card soft-card"><div class="goal-row"><span class="tile-icon green">'+icon('settings',24)+'</span><h2>Mantenimiento</h2></div><p class="muted small section-space">Saldo acumulado disponible</p><div class="money-big">'+money(balance)+'</div><div class="divider"></div>'+detail('Reserva mensual',money(m.budget.maintenance))+detail('Aportado este mes',money(savingsContributed(state.selectedMonth,'maintenance')))+'<p class="small muted" style="margin-top:14px">El dinero no utilizado se conserva. Cada mantenimiento se descuenta de este fondo, sin cobrarlo otra vez al presupuesto.</p><div class="actions section-space">'+button('Agregar aporte','contribute','soft','plus','data-fund="maintenance"')+button('Registrar mantenimiento','maintenance-expense','secondary','settings')+'</div></section></div><section class="card section-space"><div class="card-head"><h2>El historial de nuestra moto</h2><span class="badge">'+monthName(state.selectedMonth)+'</span></div>'+transactionsTable(list.slice().reverse())+'</section>';}
function renderSavings(){const b=balances(),m=month(),t=totals(),levels=[['Nivel 1 · Primer respaldo',100000],['Nivel 2 · Más tranquilidad',250000],['Nivel 3 · 3 meses esenciales',t.essential*3],['Nivel 4 · 6 meses esenciales',t.essential*6]];return heading('Hoy ahorramos. Mañana elegimos.','Nuestros fondos tienen un propósito y se mantienen separados.',button('Transferir entre fondos','transfer','secondary','arrows')+button('Agregar ahorro','new-saving','','plus'))+'<div class="grid cols2"><section class="card"><div class="goal-row"><span class="tile-icon green">'+icon('home',23)+'</span><h2>Renta que no pagamos</h2></div><p class="muted small section-space">Ahorro acumulado real</p><div class="money-big">'+money(b.rent)+'</div>'+detail('Reservado este mes',money(m.budget.rent))+detail('Aporte registrado este mes',money(savingsContributed(state.selectedMonth,'rent')))+'<div class="forecast">'+[6,12,24].map(n=>'<div><small>En '+n+' meses</small><strong>'+money(b.rent+m.budget.rent*n)+'</strong></div>').join('')+'</div><p class="field-note">Saldo actual + aportes futuros, sin intereses ni retiros.</p><p class="quote">“No pagar renta es una oportunidad para construir patrimonio, no para aumentar los gastos.”</p><div class="actions section-space">'+button('Aportar a renta','contribute','soft','plus','data-fund="rent"')+'<button class="btn secondary" data-page="budget">Editar aporte mensual</button></div></section><section class="card"><div class="goal-row"><span class="tile-icon blue">'+icon('shield',23)+'</span><h2>Fondo de emergencia</h2></div><div class="savings-number">'+money(b.emergency)+'</div><p class="muted small">Gastos esenciales del mes: '+money(t.essential)+'</p>'+levels.map(([name,target])=>'<div class="section-space"><div class="progress-label"><span>'+name+'</span><strong>'+money(target)+'</strong></div>'+progress(target?b.emergency/target*100:100,'blue')+'</div>').join('')+'<p class="field-note">Los niveles 3 y 4 se calculan con tus gastos; pueden ser menores que el nivel anterior.</p><div class="actions section-space">'+button('Aportar a emergencia','contribute','soft','plus','data-fund="emergency"')+'</div></section></div><div class="grid cols2 section-space"><section class="card"><div class="card-head"><h2>Evolución del ahorro</h2><span class="badge">Saldos reales</span></div>'+savingsChart()+'<p class="field-note">Fondos de ahorro y metas al final de cada mes. El mantenimiento se muestra en el patrimonio.</p></section><section class="card"><div class="card-head"><h2>Patrimonio en fondos</h2><strong>'+money(sum(Object.values(b)))+'</strong></div>'+allFunds().map(f=>'<div class="fund-row"><span class="tile-icon green" style="width:33px;height:33px">'+icon(f==='maintenance'?'bike':f.startsWith('goal:')?'target':'leaf',17)+'</span><span>'+escapeHtml(fundName(f))+'</span><strong>'+money(b[f])+'</strong></div>').join('')+'</section></div><section class="card section-space"><details><summary>¿Qué gastos consideramos esenciales?</summary><form id="essentials-form"><div class="field-grid">'+expenseKeys.map(c=>'<label class="check"><input type="checkbox" name="essentials" value="'+c+'" '+(m.essentials.includes(c)?'checked':'')+'>'+escapeHtml(categoryName(c))+' · '+money(m.budget[c])+'</label>').join('')+'</div><div class="form-error" role="alert"></div><div class="section-space"><button class="btn secondary" type="submit">Guardar gastos esenciales</button></div></form></details></section>';}
function savingsChart(){const keys=Object.keys(state.months).sort();const data=keys.map(k=>{const b=balances(state,k);return sum(Object.entries(b).filter(([f])=>f!=='maintenance').map(([,v])=>v));});const max=Math.max(100,...data);const width=580,height=205,x=i=>45+(keys.length===1?245:i*500/(keys.length-1)),y=v=>160-v/max*125;const points=data.map((v,i)=>x(i)+','+y(v)).join(' ');const tickStep=Math.max(1,Math.ceil(keys.length/6));return '<svg class="line-chart" viewBox="0 0 '+width+' '+height+'" role="img" aria-label="Evolución del ahorro: '+escapeHtml(keys.map((k,i)=>monthName(k)+' '+money(data[i])).join('; '))+'">'+[0,.5,1].map(n=>'<line x1="45" y1="'+y(max*n)+'" x2="555" y2="'+y(max*n)+'" stroke="var(--line)"/><text x="2" y="'+(y(max*n)-6)+'">'+Math.round(max*n/100)+'</text>').join('')+'<polygon points="45,160 '+points+' '+x(data.length-1)+',160" fill="var(--green-soft)"/><polyline points="'+points+'" fill="none" stroke="var(--green)" stroke-width="3" stroke-linejoin="round"/>'+data.map((v,i)=>'<circle cx="'+x(i)+'" cy="'+y(v)+'" r="4" fill="var(--green)"><title>'+monthName(keys[i])+': '+money(v)+'</title></circle>'+(i%tickStep===0?'<text x="'+x(i)+'" y="187" text-anchor="middle">'+new Intl.DateTimeFormat('es-EC',{month:'short',year:'2-digit'}).format(new Date(keys[i]+'-01T12:00:00'))+'</text>':'')).join('')+'</svg>';}
function resetSimulation(){simulator={income:totals().income,groceries:month().budget.groceries,rent:month().budget.rent,tv:state.equipment.find(e=>e.id==='tv')?.dec||0};}
function simulationResults(){const t=totals(),m=month(),reference=state.equipment.find(e=>e.id==='tv')?.dec||0;const changed=clone(m);changed.incomeMode='fixed';changed.income=[simulator.income,0];changed.extra=0;changed.budget.groceries=simulator.groceries;changed.budget.rent=simulator.rent;const simulated=totals(state.selectedMonth,state,changed);simulated.income=simulator.income;simulated.available-=t.extraRecorded;const tvDifference=simulator.tv-reference;simulated.available-=tvDifference;return {t,simulated,tvDifference,delta:simulated.available-t.available};}
function simulationOutput(){const r=simulationResults();return '<div class="eyebrow">RESULTADO DE ESTE ESCENARIO</div><div class="money-big '+(r.simulated.available<0?'negative':'positive')+'">'+money(r.simulated.available)+'</div><p class="muted small">quedarían disponibles este mes</p><div class="divider"></div>'+detail('Disponible actual',money(r.t.available))+detail('Cambio frente al presupuesto',(r.delta>0?'+':'')+money(r.delta))+detail('Diferencia de precio de la TV',(r.tvDifference>0?'+':'')+money(r.tvDifference))+'<div class="section-space">'+notice(r.simulated.available<0?'Debes reducir '+money(-r.simulated.available)+' del presupuesto para mantenerlo equilibrado.':'Tienes '+money(r.simulated.available)+' para distribuir.',r.simulated.available<0?'error':'success')+'</div><div class="section-space">'+donut(distribution({...month(),budget:{...month().budget,groceries:simulator.groceries,rent:simulator.rent}}),'Escenario')+'</div>';}
function renderSimulator(){if(!simulator)resetSimulation();return heading('¿Qué pasa si…?','Exploremos otras posibilidades antes de tomar una decisión.',button('Restablecer escenario','reset-simulator','secondary','arrows'))+'<div class="form-layout"><section class="card"><h2>Probemos con estos números</h2><p class="muted small" style="margin:7px 0 20px">El presupuesto real permanece intacto.</p><form id="simulator-form" class="field-grid">'+moneyInput('income','Ingreso total del mes',simulator.income)+moneyInput('groceries','Supermercado y compras',simulator.groceries)+moneyInput('rent','Ahorro como renta',simulator.rent)+moneyInput('tv','Precio de la TV',simulator.tv)+'</form><div class="period-tabs section-space">'+button('Ingresos de $1.800','sim-preset','secondary sm','','data-value="180000"')+button('Ingresos de $2.500','sim-preset','secondary sm','','data-value="250000"')+'</div><p class="field-note">Para la TV se compara con '+money(state.equipment.find(e=>e.id==='tv')?.dec||0)+' de la lista de diciembre. La diferencia se simula como una compra adicional de este mes. Si baja el precio, simula el dinero que se libera.</p><div class="section-space">'+notice('Los gastos ya registrados siguen contando si superan una categoría. Este escenario no guarda cambios ni crea movimientos.','','sliders')+'</div></section><section class="card" id="simulation-output" aria-live="polite">'+simulationOutput()+'</section></div>';}
function renderHistory(){const keys=Object.keys(state.months).sort();const m=month(),t=m.closed?.totals||totals();return heading('Nuestra vida, mes a mes.','Planeamos, registramos y cerramos cada etapa sin perder la historia.',button('Crear mes','new-month','','plus'))+'<section class="card"><div class="table-scroll"><table><thead><tr><th>Mes</th><th>Estado</th><th class="right">Ingresos</th><th class="right">Obligaciones</th><th class="right">Ahorros</th><th class="right">Metas</th><th class="right">Personal</th><th class="right">Saldo final</th><th></th></tr></thead><tbody>'+keys.map(k=>{const mm=month(k),tt=mm.closed?.totals||totals(k);return '<tr><td class="nowrap"><strong>'+monthName(k)+'</strong></td><td><span class="badge '+(mm.status==='closed'?'green':mm.status==='active'?'yellow':'')+'">'+statusNames[mm.status]+'</span></td><td class="right nowrap">'+money(tt.income)+'</td><td class="right nowrap">'+money(tt.expenses)+'</td><td class="right nowrap">'+money(tt.regularSavings)+'</td><td class="right nowrap">'+money(tt.goals)+'</td><td class="right nowrap">'+money(tt.personal)+'</td><td class="right nowrap '+(tt.available<0?'negative':'positive')+'">'+money(tt.available)+'</td><td>'+button(k===state.selectedMonth?'Seleccionado':'Abrir','select-month','secondary sm','','data-month="'+k+'"')+'</td></tr>';}).join('')+'</tbody></table></div></section><div class="grid cols2 section-space"><section class="card"><div class="card-head"><div><h2>Resumen de '+monthName(state.selectedMonth).toLowerCase()+'</h2><p>'+(m.closed?'Cerrado el '+new Date(m.closed.at).toLocaleString('es-EC'):'Revisa las cifras antes de cerrar el mes.')+'</p></div><span class="badge">'+statusNames[m.status]+'</span></div>'+detail('Ingresos',money(t.income))+detail('Gastos hogar (presupuesto)',money(m.budget.groceries+m.budget.services))+detail('IESS',money(m.budget.iess1+m.budget.iess2))+detail('Moto (gasolina + reserva)',money(m.budget.gas+m.budget.maintenance))+detail('Ahorro y metas (presupuesto)',money(t.savings))+detail('Dinero personal',money(t.personal))+detail('Excesos reales sobre reservas',money(t.over))+detail('Saldo disponible',money(t.available))+'<div class="divider"></div>'+detail('Gastos efectivamente registrados',money(t.spent))+detail('Aportes efectivamente registrados',money(t.funded))+detail('Ahorro total acumulado',money(sum(Object.entries(balances(state,state.selectedMonth)).filter(([f])=>f!=='maintenance').map(([,v])=>v))))+detail('Patrimonio en fondos al cierre',money(m.closed?.patrimony??sum(Object.values(balances(state,state.selectedMonth)))))+'</section><section class="card"><h2>Cerrar una etapa</h2><p class="muted small" style="margin:10px 0 20px">Al cerrar, se registran solamente los aportes pendientes de renta, emergencia, metas y mantenimiento. Las compras no realizadas no se convierten en gastos ficticios.</p>'+notice('Revisa los gastos reales antes de cerrar. El saldo mostrado descuenta las reservas del presupuesto, aunque parte de ellas todavía no se haya gastado.','','info')+'<div class="actions section-space">'+(m.status==='closed'?button('Reabrir mes','reopen-month','secondary','lock'):button('Cerrar mes','close-month','','check')+button('Marcar en curso','activate-month','secondary','calendar'))+button('Imprimir / Guardar PDF','print','secondary','print')+'</div><div class="divider"></div><h3>El siguiente paso</h3><p class="muted small" style="margin:8px 0 15px">Copiar un presupuesto reutiliza los importes. Tus movimientos y saldos se mantienen separados.</p>'+button('Copiar mes anterior','copy-month','soft','copy')+'</section></div>';}
function renderSettings(){const s=state.settings;return heading('Nuestro espacio, a nuestra manera.','Personaliza los nombres, los aportes y la forma de ver el dinero.')+'<div class="grid cols2"><form id="settings-form" class="card"><h2>Los dos y nuestro hogar</h2><div class="field-grid section-space"><label>Nombre del integrante 1<input name="name1" maxlength="60" required value="'+escapeHtml(s.names[0])+'"></label><label>Nombre del integrante 2<input name="name2" maxlength="60" required value="'+escapeHtml(s.names[1])+'"></label><label class="full">Nombre de nuestro hogar<input name="couple" maxlength="80" required value="'+escapeHtml(s.couple)+'"></label><label>Moneda<select disabled aria-label="Moneda"><option>USD · Dólar estadounidense</option></select></label><label>Formato de montos<select name="format">'+selectOptions([['es','$1.000,00'],['us','$1,000.00']],s.format)+'</select></label>'+moneyInput('limit','Límite para conversar una compra',s.limit)+'<label>Apariencia<select name="theme">'+selectOptions([['light','Modo claro'],['dark','Modo oscuro']],s.theme)+'</select></label><label class="check full"><input type="checkbox" name="sameIess" '+(s.sameIess?'checked':'')+'>Usar el mismo aporte IESS para ambos</label><label class="check full"><input type="checkbox" name="autoRedirect" '+(s.autoRedirect?'checked':'')+'>Redirigir aportes futuros de muebles a equipar el hogar cuando se complete la meta</label></div><p class="field-note">Los ingresos reales se registran por fecha en Ingresos NEOMAR; los gastos y reservas mensuales se editan en Presupuesto. La opción de IESS se aplica al guardar ese presupuesto.</p><div class="form-error" role="alert"></div><div class="actions section-space"><button type="submit" class="btn">Guardar configuración</button><button type="button" class="btn secondary" data-page="budget">Editar importes del mes</button></div></form><div><section class="card"><div class="goal-row"><span class="tile-icon green">'+icon('shield',22)+'</span><h2>Tu información, contigo</h2></div><p class="muted small" style="margin-top:14px">Los cambios se guardan automáticamente en este navegador después de confirmar cada formulario. No se envían a un servidor ni se sincronizan entre dispositivos.</p><div class="actions section-space">'+button('Exportar datos JSON','export-json','soft','down')+button('Importar datos','import-json','secondary','up')+button('Exportar movimientos CSV','export-csv','secondary','down')+'</div><p class="field-note">Importar reemplaza todos los datos después de validar la copia y pedirte confirmación. Conserva una copia antes de borrar los datos del navegador o mover el archivo.</p></section><section class="card section-space"><details><summary>Saldos que ya teníamos</summary><p class="muted small" style="margin-bottom:16px">Solo para dinero previo al primer registro. Los nuevos aportes se añaden como movimientos.</p><form id="opening-form"><div class="field-grid">'+fundKeys.map(f=>moneyInput(f,categoryNames[f],state.initialFunds[f])).join('')+'</div><p class="field-note">Los saldos iniciales de las metas se editan en cada meta. Para preservar cierres, estos saldos solo pueden cambiarse si no hay meses cerrados.</p><div class="form-error" role="alert"></div><button class="btn secondary section-space" type="submit">Guardar saldos iniciales</button></form></details></section></div></div><section class="card section-space"><h2>Empezar de nuevo</h2><p class="muted small" style="margin:8px 0 15px">Borra los movimientos, las metas personalizadas y la configuración. Se cargará de nuevo el presupuesto inicial.</p>'+button('Borrar todos los datos','reset-all','danger','trash')+'</section>';}
function buildPrintReport(){const k=state.selectedMonth,m=month(),t=m.closed?.totals||totals();$('#print-report').innerHTML='<div class="heading"><div><div class="eyebrow">NUESTRO PRESUPUESTO · '+escapeHtml(state.settings.couple)+'</div><h1>Resumen de '+monthName(k).toLowerCase()+'</h1><p>'+statusNames[m.status]+' · Finanzas, hogar y metas juntos</p></div></div><div class="stats">'+stat('Ingresos',t.income,'Ingresos del hogar','down')+stat('Obligaciones',t.expenses,'Incluye reserva de moto','wallet')+stat('Ahorro y metas',t.savings,'Planificado','leaf')+stat('Disponible',t.available,'Tras reservas y excesos','arrows')+'</div><div class="grid cols2"><div class="card"><h2>Presupuesto mensual</h2>'+(m.incomeMode==='daily'?detail('NEOMAR · ingresos diarios',money(dailySummary(k).total))+detail('Otros ingresos registrados',money(dailySummary(k).otherIncome)):'')+Object.entries(m.budget).filter(([k])=>k!=='goals').map(([c,v])=>detail(escapeHtml(categoryName(c)),money(v))).join('')+Object.entries(m.budget.goals).map(([id,v])=>detail(escapeHtml(goal(id)?.name||'Meta'),money(v))).join('')+detail('Excesos registrados',money(t.over))+detail('Gastos registrados',money(t.spent))+detail('Aportes registrados',money(t.funded))+'</div><div class="card"><h2>Distribución mensual</h2>'+donut(distribution(m))+'<div class="divider"></div><h2>Estado de las metas</h2>'+state.goals.map(g=>{const p=goalProgress(g,state,k);return '<div class="section-space"><h3>'+escapeHtml(g.name)+'</h3>'+progress(p.pct)+'<div class="progress-label"><span>'+money(p.achieved)+' / '+money(g.target)+'</span><span>'+percent(p.pct)+'</span></div><p class="field-note">Fecha objetivo: '+dateName(g.due)+'</p></div>';}).join('')+'<div class="divider"></div>'+detail('Ahorro acumulado',money(sum(Object.entries(balances(state,k)).filter(([f])=>f!=='maintenance').map(([,v])=>v))))+detail('Patrimonio en fondos',money(m.closed?.patrimony??sum(Object.values(balances(state,k)))))+'</div></div><p class="small muted section-space">El dinero del negocio se mantiene separado. El disponible descuenta el presupuesto reservado y los excesos reales; las transferencias entre fondos no se contabilizan como gastos.</p><p class="small muted section-space">Generado el '+new Date().toLocaleString('es-EC')+'</p>';}

function renderPersonalCards(){return '<div class="grid cols2 section-space">'+state.settings.names.map((name,i)=>{const key='personal'+(i+1),assigned=month().budget[key],spent=spending(state.selectedMonth,key);return '<section class="card"><div class="goal-row"><span class="tile-icon '+(i?'blue':'green')+'">'+icon('wallet')+'</span><div><p class="eyebrow">CUENTA PERSONAL</p><h2>'+escapeHtml(name)+'</h2></div></div><div class="savings-number">'+money(assigned)+' <span class="muted small">/ mes</span></div><p class="muted small">El dinero personal pertenece a cada integrante y puede utilizarse libremente.</p><div class="divider"></div>'+detail('Gastos registrados (opcional)',money(spent))+detail('Disponible personal',money(assigned-spent))+'</section>';}).join('')+'</div>';}

/* NEOMAR: a single net household-income record per date, in integer cents.
 * Estimates never enter income totals. A recorded zero is a completed day;
 * an absent record is unknown. Tuesdays, Fridays, Saturdays and Sundays.
 */
const NEOMAR_DAYS=[0,2,5,6];
function isNeomar(t){return t.type==='income'&&t.category==='neomar';}
function workDates(k){const dates=[];for(let day=1;day<=Number(lastDate(k).slice(-2));day++){const date=k+'-'+String(day).padStart(2,'0');if(NEOMAR_DAYS.includes(new Date(date+'T12:00:00').getDay()))dates.push(date);}return dates;}
function dailyRecords(k=state.selectedMonth,s=state){return transactions(k,s).filter(isNeomar).slice().sort((a,b)=>a.date.localeCompare(b.date));}
function dailySummary(k=state.selectedMonth,s=state){
 const rows=dailyRecords(k,s),scheduled=workDates(k),recorded=new Set(rows.map(r=>r.date));
 const total=sum(rows.map(r=>r.amount)),missing=scheduled.filter(d=>!recorded.has(d));
 const average=rows.length?Math.round(total/rows.length):null;
 const t=totals(k,s),uncovered=Math.max(0,t.planned+t.over-t.income);
 return {rows,scheduled,missing,total,count:rows.length,average,projection:average===null?null:total+Math.round(total/rows.length*missing.length),uncovered,needed:missing.length?Math.ceil(uncovered/missing.length):null,dailyTarget:Math.ceil(t.planned/scheduled.length),otherIncome:sum(transactions(k,s).filter(t=>t.type==='income'&&!isNeomar(t)).map(t=>t.amount))};
}
function migrateState(value){
 const s=clone(value);validateState(s);if(s.version===VERSION)return s;
 const lastClosed=Object.keys(s.months).filter(k=>s.months[k].status==='closed').sort().at(-1)||'';
 for(const[k,m]of Object.entries(s.months))m.incomeMode=(m.status==='closed'||k<lastClosed)?'fixed':'daily';
 s.version=VERSION;validateState(s);return s;
}
function dailyDateLabel(date){return new Intl.DateTimeFormat('es-EC',{weekday:'long',day:'numeric',month:'short'}).format(new Date(date+'T12:00:00'));}
function defaultDailyDate(){const k=state.selectedMonth,d=today(),scheduled=workDates(k);if(d.startsWith(k))return d;const recorded=new Set(dailyRecords(k).map(t=>t.date));return scheduled.find(date=>!recorded.has(date))||scheduled[0]||k+'-01';}
function dailyIncomeForm(date=defaultDailyDate()){
 assert(validDate(date)&&month(date.slice(0,7)),'Selecciona una fecha de un mes creado.');ensureOpen(date.slice(0,7));
 const existing=dailyRecords(date.slice(0,7)).find(t=>t.date===date);
 const amount=existing?amountInput(existing.amount):'';
 openModal(existing?'Editar ingreso de NEOMAR':'Ingreso del día · NEOMAR','<div class="field-grid"><label>Fecha<input type="date" name="dailyDate" value="'+date+'" required min="2000-01-01" max="2200-12-31" '+(existing?'readonly':'')+'></label><label>Dinero disponible para nosotros<span class="input-money"><span>$</span><input type="number" name="dailyAmount" min="0" max="1000000000" step="0.01" required value="'+amount+'" placeholder="0.00" inputmode="decimal"></span></label><label class="full">Nota (opcional)<input name="dailyNote" maxlength="240" placeholder="Por ejemplo, jornada de sábado" value="'+escapeHtml(existing?.note||'')+'"></label></div><p class="field-note">Ingresa el total que queda para ambos después de cubrir los costos de NEOMAR. Un día sin ingresos puede registrarse con $0.</p><div id="daily-entry-preview" class="section-space" aria-live="polite"></div>','Guardar ingreso',fd=>{
  const selectedDate=fd.get('dailyDate'),k=selectedDate.slice(0,7);assert(validDate(selectedDate)&&month(k),'Primero crea el mes de esta fecha en Mes a mes.');ensureOpen(k);
  const duplicate=state.transactions.find(t=>isNeomar(t)&&t.date===selectedDate&&t.id!==existing?.id);
  assert(!duplicate,'Ya registraste esta fecha. Edita su tarjeta para cambiar el importe sin duplicarlo.');
  assert(!existing||selectedDate===existing.date,'Para cambiar la fecha, elimina el registro y créalo en el día correcto.');
  const tx={id:existing?.id||uid(),date:selectedDate,type:'income',category:'neomar',amount:cents(fd.get('dailyAmount')),note:fd.get('dailyNote').trim(),description:'NEOMAR · '+dailyDateLabel(selectedDate),person:'both',account:'home',from:null,to:null,source:'manual'};
  commit(()=>{month(k).incomeMode='daily';if(existing)state.transactions[state.transactions.findIndex(t=>t.id===existing.id)]=tx;else addTransaction(tx);state.selectedMonth=k;simulator=null;},'Ingreso diario guardado. El mes se recalculó.');
 });
 const preview=()=>{
  const form=$('#modal-form'),fd=new FormData(form),date=fd.get('dailyDate'),k=date?.slice(0,7);if(!validDate(date)||!month(k)){ $('#daily-entry-preview').innerHTML='';return; }
  let amount;try{amount=cents(fd.get('dailyAmount'));}catch{$('#daily-entry-preview').innerHTML=notice('Escribe el importe neto de esta jornada para ver el nuevo total.');return;}
  const duplicate=state.transactions.find(t=>isNeomar(t)&&t.date===date&&t.id!==existing?.id);
  if(duplicate){$('#daily-entry-preview').innerHTML=notice('Esta fecha ya tiene '+money(duplicate.amount)+' registrados. Edita su tarjeta; no se guardará un duplicado.','warning');return;}
  const income=sum(transactions(k).filter(t=>t.type==='income'&&t.id!==existing?.id).map(t=>t.amount))+amount;
  const t=totals(k),available=income-t.planned-t.over;
  $('#daily-entry-preview').innerHTML=detail('Ingreso real del mes con este registro',money(income))+detail('Tras cubrir el presupuesto mensual',money(available))+(NEOMAR_DAYS.includes(new Date(date+'T12:00:00').getDay())?'':notice('Esta fecha está fuera del horario habitual. Se guardará como una jornada adicional.'))+(month(k).incomeMode==='fixed'?notice('Al guardar, este mes pasará a ingresos diarios. Los importes mensuales anteriores se conservarán como referencia y dejarán de sumarse.','warning'):'');
 };
 $('#modal-form').addEventListener('input',preview);preview();
}
function dailyBudgetIncome(){const d=dailySummary();return detail('NEOMAR · ingresos diarios',money(d.total))+detail('Otros ingresos registrados',money(d.otherIncome))+detail('Total real del mes',money(totals().income))+'<div class="actions section-space">'+button('Registrar ingreso del día','daily-income','soft','plus')+'<button type="button" class="btn secondary" data-page="daily">Ver jornadas de NEOMAR</button></div><p class="field-note">El ingreso se calcula con los registros reales. Los sueldos estimados de $1.000 por persona y los extras planificados del presupuesto anterior ya no se suman.</p>';}
function dailyHomeSummary(){if(month().incomeMode!=='daily')return '';const d=dailySummary();return '<section class="daily-banner"><div><span class="eyebrow">NEOMAR · INGRESOS VARIABLES</span><strong>'+d.count+' jornadas registradas · '+money(d.total)+' para el hogar</strong><p>Martes, viernes, sábado y domingo. Cada día cuenta con su monto real.</p></div><button class="btn secondary" data-page="daily">Ver ingresos diarios '+icon('right',16)+'</button></section>';}
function renderDaily(){
 const d=dailySummary(),t=totals(),rows=new Map(d.rows.map(r=>[r.date,r]));
 const dates=[...new Set([...d.scheduled,...d.rows.map(r=>r.date)])].sort();
 const locked=month().status==='closed'||Object.keys(state.months).some(k=>k>state.selectedMonth&&month(k).status==='closed');
 return heading('Cada jornada cuenta.','NEOMAR · el dinero que queda para los dos, día a día.',button('Registrar ingreso del día','daily-income','','plus',locked?'disabled':''))+
 '<div class="notice success">'+icon('calendar',19)+'<span>Horario habitual: <strong>martes, viernes, sábado y domingo</strong>. Este mes tiene '+d.scheduled.length+' jornadas previstas.</span></div>'+
 (month().incomeMode!=='daily'?'<div class="section-space">'+notice('Este mes conserva el cálculo mensual anterior para proteger su historial. Al reabrirlo y guardar su primer ingreso diario, podrás usar el nuevo cálculo.')+'</div>':'')+
 '<section class="stats section-space">'+stat('NEOMAR este mes',d.total,d.count+' jornadas registradas · montos netos','down')+stat('Promedio por jornada',d.average||0,d.count?'Incluye jornadas registradas con $0':'Se calculará con el primer registro','chart')+stat('Por cubrir del plan',d.uncovered,'Presupuesto mensual menos ingresos reales','wallet',true)+stat('Referencia por jornada',d.dailyTarget,'Plan del mes ÷ '+d.scheduled.length+' jornadas habituales','calendar')+'</section>'+
 '<div class="grid cols2"><section class="card"><div class="card-head"><div><h2>Lo que falta para cubrir el mes</h2><p>La referencia se actualiza con cada monto que ingresas</p></div><span class="badge">'+d.missing.length+' sin registrar</span></div>'+detail('Presupuesto y excesos registrados',money(t.planned+t.over))+detail('Ingresos reales (NEOMAR + otros)',money(t.income))+detail('Falta reunir',money(d.uncovered))+detail('Por jornada pendiente de registrar',d.needed===null?'Sin jornadas pendientes':money(d.needed))+'<p class="field-note">Se reparte lo que falta entre las jornadas habituales sin registrar, incluidas fechas pasadas. Una jornada con $0 ya cuenta como registrada.</p>'+progress((t.planned+t.over)>0?t.income/(t.planned+t.over)*100:100)+'</section><section class="card"><div class="card-head"><div><h2>Una referencia para planear</h2><p>La proyección es una estimación, no dinero disponible</p></div>'+icon('chart')+'</div><div class="savings-number">'+(d.projection===null?'Por calcular':money(d.projection))+'</div><p class="muted small">Posible ingreso de NEOMAR si las '+d.missing.length+' jornadas sin registrar mantienen el promedio de las '+d.count+' registradas.</p><div class="divider"></div>'+distribution().map(([name,value])=>detail(name+' · referencia por jornada',money(Math.round(value/d.scheduled.length)))).join('')+'<p class="field-note">Referencias redondeadas. Tus gastos y reservas siguen definidos en Presupuesto; registrar un ingreso no crea aportes automáticos a fondos.</p></section></div>'+
 '<section class="card section-space"><div class="card-head"><div><h2>Las jornadas de '+monthName(state.selectedMonth).toLowerCase()+'</h2><p>Registra el total de cada fecha. Puedes editarlo sin duplicar el ingreso.</p></div><span class="badge green">'+d.count+' registradas</span></div><div class="daily-grid">'+dates.map(date=>{const r=rows.get(date),extra=!d.scheduled.includes(date);return '<article class="day-card '+(r?'recorded':'')+'"><div class="day-top"><span>'+escapeHtml(dailyDateLabel(date))+'</span><span class="badge '+(r?'green':'')+'">'+(extra?'Adicional':r?'Registrado':'Pendiente')+'</span></div><div class="day-amount">'+(r?money(r.amount):'<span class="muted">Sin registrar</span>')+'</div>'+(r?.note?'<p class="small muted">'+escapeHtml(r.note)+'</p>':'')+'<div class="actions">'+button(r?'Editar ingreso':'Registrar','daily-income',r?'secondary sm':'soft sm',r?'edit':'plus','data-date="'+date+'" '+(locked?'disabled':''))+(r&&!locked?'<button type="button" class="icon-btn" data-action="delete-transaction" data-id="'+escapeHtml(r.id)+'" aria-label="Eliminar ingreso del '+date+'">'+icon('trash',16)+'</button>':'')+'</div></article>';}).join('')+'</div></section>'+closedNotice();
}
function closeMonthDialog(){
 ensureOpen();const k=state.selectedMonth,m=month(),t=totals(),remaining=sum(Object.entries(planFunds(m)).map(([f,a])=>Math.max(0,a-savingsContributed(k,f))));
 const canComplete=m.incomeMode!=='daily'||t.available>=0;
 openModal('Cerrar '+monthName(k),'<p>Se guardará el resumen del mes y se protegerá su historial.</p><div class="section-space">'+detail('Ingresos registrados / contabilizados',money(t.income))+detail('Aportes pendientes según el plan',money(remaining))+'</div><label class="check section-space"><input type="checkbox" name="completeFunds" '+(canComplete?'checked':'disabled')+'>Completar los aportes pendientes a los fondos</label><p class="field-note">'+(canComplete?'Si lo desmarcas, se conservan únicamente los aportes ya registrados.':'El ingreso real todavía no cubre el plan. Se cerrará con los aportes realmente registrados, sin crear ahorros que no se han financiado.')+'</p>','Cerrar mes',fd=>commit(()=>closeMonth(k,fd.has('completeFunds')),'Mes cerrado. El resumen conserva los ingresos y aportes registrados.'));
}

/* Dialogs and actions. Destructive changes always require confirmation. */
let modalReturnFocus=null;
let modalSubmit=null;
function openModal(title,body,submitLabel,onSubmit,options={}){
 const d=$('#dialog');modalReturnFocus=document.activeElement;modalSubmit=onSubmit;
 d.innerHTML='<form id="modal-form"><div class="modal-head"><h2 id="modal-title">'+escapeHtml(title)+'</h2><button class="icon-btn" type="button" data-action="close-modal" aria-label="Cerrar">'+icon('close',18)+'</button></div><div class="modal-body">'+body+'<div class="form-error" role="alert"></div></div><div class="modal-actions">'+button('Cancelar','close-modal','secondary')+'<button class="btn '+(options.danger?'danger':'')+'" type="submit">'+escapeHtml(submitLabel)+'</button></div></form>';
 if(!d.open)d.showModal();
 $('#modal-form').addEventListener('submit',event=>{event.preventDefault();const form=event.currentTarget;if(!form.reportValidity())return;try{const result=modalSubmit(new FormData(form),form);if(result!==false)closeModal();}catch(e){$('.form-error',form).textContent=e.message;}});
 requestAnimationFrame(()=>{const input=$('input:not([type=hidden]),select,textarea',d);(input||$('button[type=submit]',d)).focus();});
}
function closeModal(){const d=$('#dialog');d.close();modalSubmit=null;modalReturnFocus?.isConnected&&modalReturnFocus.focus();}
function confirmModal(title,text,action,label='Confirmar',danger=false){openModal(title,'<p>'+text+'</p>',label,()=>action(),{danger});}
function txForm(preset={}){
 ensureOpen();const type=preset.type||'expense';
 const body='<div class="field-grid"><label>Tipo de movimiento<select name="type" id="tx-type">'+selectOptions(Object.entries(typeNames),type)+'</select></label><label>Fecha<input type="date" name="date" required value="'+inputDate()+'" min="2000-01-01" max="2200-12-31"></label><label class="full">Descripción<input name="description" maxlength="300" placeholder="Por ejemplo, compra quincenal" required value="'+escapeHtml(preset.description||'')+'"></label>'+moneyInput('amount','Monto',preset.amount||0,'min="0.01"')+'<label>Persona<select name="person">'+selectOptions([['both','Ambos'],['1',state.settings.names[0]],['2',state.settings.names[1]]],'both')+'</select></label><div class="full" id="tx-fields"></div><div class="full" id="tx-warning"></div></div>';
 openModal('Nuevo movimiento',body,'Guardar movimiento',(fd)=>{
 const date=fd.get('date');assert(validDate(date),'Selecciona una fecha válida.');const k=date.slice(0,7);assert(state.months[k],'Crea primero '+monthName(k)+' en Mes a mes.');ensureOpen(k);
 const tx={id:uid(),date,type:fd.get('type'),description:fd.get('description').trim(),amount:cents(fd.get('amount'),false),person:fd.get('person'),account:'home',category:'other',from:null,to:null,source:'manual'};
 assert(tx.description,'Escribe una descripción.');
 if(tx.type==='income'){tx.category=fd.get('category');}
 if(tx.type==='saving'){tx.to=fd.get('to');tx.category=tx.to;tx.account='savings';assert(allFunds().includes(tx.to),'Selecciona un fondo.');}
 if(tx.type==='transfer'){tx.from=fd.get('from');tx.to=fd.get('to');tx.category=tx.to;tx.account='savings';assert(allFunds().includes(tx.from)&&allFunds().includes(tx.to)&&tx.from!==tx.to,'Elige dos fondos diferentes.');}
 if(tx.type==='expense'){tx.account=fd.get('account');if(tx.account==='savings'){tx.from=fd.get('from');tx.category=tx.from;assert(allFunds().includes(tx.from),'Selecciona el fondo del gasto.');}else if(tx.account.startsWith('personal'))tx.category=tx.account;else tx.category=fd.get('category');if(tx.category==='groceries')tx.subtype=fd.get('subtype')||'Supermercado';}
 commit(()=>addTransaction(tx),'Movimiento guardado.');
 });
 updateTxFields(type,preset);
 $('#tx-type').addEventListener('change',e=>updateTxFields(e.target.value));
 $('#modal-form').addEventListener('input',updateTxWarning);
}
function fundSelect(name,label,selected='',includeBalance=false){const b=balances();return '<label>'+label+'<select name="'+name+'">'+selectOptions(allFunds().map(f=>[f,fundName(f)+(includeBalance?' · '+money(b[f]):'')]),selected||allFunds()[0])+'</select></label>';}
function updateTxFields(type,preset={}){
 const el=$('#tx-fields');let body='';
 if(type==='income')body='<label>Categoría<select name="category">'+selectOptions([['bonus','Bono'],['additional','Ganancias adicionales'],['extra','Ingreso extraordinario']],preset.category||'extra')+'</select></label><p class="field-note">Se suma al ingreso real del mes. Los montos de NEOMAR se registran en Ingresos NEOMAR; no vuelvas a ingresarlos aquí.</p>';
 if(type==='saving')body=fundSelect('to','Fondo de destino',preset.to)+'<p class="field-note">Este aporte sale del ingreso del hogar y utiliza la reserva de ese fondo. Solo la parte que supera lo planificado reduce el disponible adicionalmente.</p>';
 if(type==='transfer')body='<div class="field-grid">'+fundSelect('from','Desde',preset.from||'rent',true)+fundSelect('to','Hacia',preset.to||'emergency')+'</div><p class="field-note">Mueve dinero existente entre fondos. No es un ingreso ni un gasto nuevo.</p>';
 if(type==='expense')body='<label>Cuenta de pago<select name="account" id="tx-account">'+selectOptions([['home','Cuenta conjunta del hogar'],['savings','Pagar con un fondo'],['personal1','Personal · '+state.settings.names[0]],['personal2','Personal · '+state.settings.names[1]]],preset.account||'home')+'</select></label><div id="expense-fields" style="margin-top:16px"></div>';
 el.innerHTML=body;
 if(type==='expense'){updateExpenseFields(preset.account||'home',preset);$('#tx-account').addEventListener('change',e=>{updateExpenseFields(e.target.value);updateTxWarning();});}
 updateTxWarning();
}
function updateExpenseFields(account,preset={}){const el=$('#expense-fields');if(account==='savings')el.innerHTML=fundSelect('from','Fondo que paga esta compra',preset.from||'maintenance',true)+'<p class="field-note">El gasto se descuenta del fondo. No se vuelve a cargar al disponible mensual.</p>';else if(account.startsWith('personal'))el.innerHTML=notice('El dinero personal puede utilizarse libremente. Registrar estos gastos es opcional.');else{el.innerHTML='<div class="field-grid"><label>Categoría<select name="category" id="tx-category">'+selectOptions(['groceries','services','iess1','iess2','gas','other'].map(c=>[c,categoryName(c)]),preset.category||'groceries')+'</select></label><label id="subtype-label">Tipo de compra<select name="subtype">'+selectOptions(['Supermercado','Limpieza','Hogar','Otros'].map(x=>[x,x]),'Supermercado')+'</select></label></div>';const toggle=()=>{$('#subtype-label').hidden=$('#tx-category').value!=='groceries';};$('#tx-category').addEventListener('change',toggle);toggle();}}
function updateTxWarning(){const form=$('#modal-form');if(!form||!$('#tx-warning'))return;const fd=new FormData(form);let a=0;try{a=cents(fd.get('amount')||0);}catch{}const account=fd.get('account');$('#tx-warning').innerHTML=fd.get('type')==='expense'&&!String(account).startsWith('personal')&&a>state.settings.limit?notice('Las compras con dinero conjunto superiores a '+money(state.settings.limit)+' deberían conversarse antes.','warning','heart'):'';}
function goalForm(id=null){
 const g=id?goal(id):{id:uid(),name:'',target:150000,initial:0,due:lastDate(shiftMonth(state.selectedMonth,5)),start:state.selectedMonth,monthly:0};assert(g,'No se encontró la meta.');
 const lockedOpening=Object.values(state.months).some(m=>m.status==='closed');
 openModal(id?'Editar meta':'Una nueva meta juntos','<div class="field-grid"><label class="full">Nombre de la meta<input name="name" required maxlength="120" value="'+escapeHtml(g.name)+'" placeholder="Por ejemplo, nuestro primer viaje"></label>'+moneyInput('target','Valor objetivo',g.target,'min="0.01"')+moneyInput('initial','Ahorrado antes de usar la app',g.initial,lockedOpening?'readonly':'')+'<label>Mes de inicio<input type="month" name="start" required min="2000-01" max="2200-12" value="'+g.start+'"></label><label>Fecha objetivo<input type="date" name="due" required min="2000-01-01" max="2200-12-31" value="'+g.due+'"></label>'+moneyInput('monthly','Aporte mensual',g.monthly)+'<label class="check"><input type="checkbox" name="apply" checked>Aplicar aporte a meses abiertos del periodo</label></div><p class="field-note">Los aportes reales se registran con “Agregar aporte”. El saldo inicial representa dinero previo al registro; no lo uses para los nuevos depósitos.'+(lockedOpening?' Está protegido porque ya hay meses cerrados.':'')+'</p>','Guardar meta',fd=>{
 const edited={id:g.id,name:fd.get('name').trim(),target:cents(fd.get('target'),false),initial:cents(fd.get('initial')),start:fd.get('start'),due:fd.get('due'),monthly:cents(fd.get('monthly'))};assert(edited.name,'Escribe el nombre de la meta.');assert(validDate(edited.due)&&validMonth(edited.start)&&edited.start<=edited.due.slice(0,7),'La fecha objetivo debe estar en el mes de inicio o después.');assert(!lockedOpening||edited.initial===g.initial,'Reabre los meses antes de cambiar el saldo inicial.');
 commit(()=>{if(id)state.goals[state.goals.findIndex(x=>x.id===id)]=edited;else state.goals.push(edited);reconcileRedirects();if(fd.has('apply'))for(const[k,m]of Object.entries(state.months))if(m.status!=='closed'&&k>=state.selectedMonth){if(['furniture','equipment'].includes(g.id))m.redirected=null;m.budget.goals[g.id]=k>=edited.start&&k<=edited.due.slice(0,7)?edited.monthly:0;}},'Meta guardada.');
 });
}
function budgetFromForm(form){const fd=new FormData(form),m=clone(month());if(m.incomeMode!=='daily'){m.income=[cents(fd.get('income1')),cents(fd.get('income2'))];m.extra=cents(fd.get('extra'));}for(const key of [...expenseKeys,'rent','emergency','investment','personal1','personal2'])m.budget[key]=cents(fd.get(key));if(state.settings.sameIess)m.budget.iess2=m.budget.iess1;for(const g of state.goals)m.budget.goals[g.id]=cents(fd.get('goal_'+g.id));m.stable=false;m.redirected=null;return m;}
function activateStablePlan(){ensureOpen();const a=stableAmounts(),m=month();const fixed=sum(['services','iess1','iess2','gas','maintenance'].map(k=>m.budget[k]));const grocery=Math.max(0,a.household-fixed);const over=Math.max(0,fixed-a.household);openModal('Un presupuesto para la siguiente etapa',stableDonut()+'<div class="section-space">'+notice('Para reservar el 40% al hogar, el supermercado pasará de '+money(m.budget.groceries)+' a '+money(grocery)+'. Los aportes a muebles y otras metas se reemplazan por el fondo Metas / inversión.','warning')+'</div>'+(over?'<div class="section-space">'+notice('Las obligaciones fijas ya superan el 40% del ingreso en '+money(over)+'. El plan quedará excedido por ese monto.','error')+'</div>':''),'Aplicar a este mes',()=>commit(()=>{const b=m.budget;b.groceries=grocery;b.emergency=a.emergency;b.rent=a.rent;b.investment=a.investment;b.personal1=Math.floor(a.personal/2);b.personal2=a.personal-b.personal1;b.goals={};m.stable=true;m.redirected=null;},'Plan estable aplicado a '+monthName(state.selectedMonth)+'.'));}
function newMonthForm(){const next=shiftMonth(Object.keys(state.months).sort().at(-1),1);openModal('Planear un nuevo mes','<div class="field-grid"><label>Nuevo mes<input type="month" name="month" required min="2000-01" max="2200-12" value="'+next+'"></label><label>Usar como base<select name="source">'+selectOptions([['','Presupuesto inicial'],...Object.keys(state.months).sort().map(k=>[k,monthName(k)])],state.selectedMonth)+'</select></label></div><p class="field-note">Se copian los importes y las categorías esenciales. Los movimientos y los saldos no se duplican.</p>','Crear mes',fd=>{const key=fd.get('month');assert(validMonth(key),'Selecciona un mes válido.');assert(!state.months[key],'Ese mes ya existe.');commit(()=>{state.months[key]=newMonth(key,fd.get('source')?month(fd.get('source')):null);for(const g of state.goals){if(key<g.start||key>g.due.slice(0,7)||goalProgress(g).remaining===0)state.months[key].budget.goals[g.id]=0;}state.selectedMonth=key;simulator=null;},'Nuevo mes creado.');});}
function copyPrevious(){ensureOpen();const previous=shiftMonth(state.selectedMonth,-1);assert(state.months[previous],'No existe el mes anterior. Puedes crearlo en Mes a mes.');confirmModal('Copiar el presupuesto anterior','Se reemplazarán los importes de '+monthName(state.selectedMonth)+' con los de '+monthName(previous)+'. Los movimientos del mes se conservarán.',()=>commit(()=>{const m=month();const source=month(previous);m.income=clone(source.income);m.extra=source.extra;m.budget=clone(source.budget);m.essentials=clone(source.essentials);m.stable=source.stable;m.redirected=null;},'Presupuesto copiado.'),'Copiar presupuesto');}
function deleteTransaction(id){const t=state.transactions.find(t=>t.id===id);assert(t,'No se encontró el movimiento.');ensureOpen(t.date.slice(0,7));assert(t.source!=='close','Reabre el mes para deshacer las reservas del cierre.');confirmModal('Eliminar movimiento','¿Eliminar “'+escapeHtml(t.description)+'” por '+money(t.amount)+'? Los saldos se recalcularán.',()=>commit(()=>{state.transactions=state.transactions.filter(x=>x.id!==id);},'Movimiento eliminado.'),'Eliminar',true);}
function deleteGoal(id){const g=goal(id);assert(g,'No se encontró la meta.');const fund='goal:'+id;assert(!state.transactions.some(t=>t.to===fund||t.from===fund),'Esta meta tiene movimientos vinculados. Conserva la meta para mantener el historial; puedes poner su aporte mensual en cero.');assert(!Object.values(state.months).some(m=>m.status==='closed'&&m.budget.goals[id]),'La meta forma parte de un mes cerrado y debe conservarse en el historial.');assert(!g.initial,'Esta meta tiene un saldo inicial. Edita o transfiere el saldo antes de eliminarla.');confirmModal('Eliminar meta','Se eliminará “'+escapeHtml(g.name)+'” y sus aportes planificados en meses abiertos.',()=>commit(()=>{state.goals=state.goals.filter(x=>x.id!==id);for(const m of Object.values(state.months))delete m.budget.goals[id];},'Meta eliminada.'),'Eliminar meta',true);}
function redirectCurrent(){ensureOpen();assert(goal('equipment'),'Crea primero la meta Equipar nuestro hogar.');const amount=month().budget.goals.furniture||0;confirmModal('Redirigir el aporte mensual','Se moverán '+money(amount)+' del aporte planificado para muebles a Equipar nuestro hogar en este mes. Los saldos ahorrados se conservan.',()=>commit(()=>{month().budget.goals.furniture=0;month().budget.goals.equipment=(month().budget.goals.equipment||0)+amount;},'Aporte redirigido.'),'Redirigir aporte');}
function allocateAvailable(f){ensureOpen();const amount=totals().available;assert(amount>0,'Este mes no hay dinero disponible para asignar.');confirmModal('Dar un destino al disponible','Se reservarán los '+money(amount)+' disponibles para '+escapeHtml(fundName(f))+'. Se registrará el aporte pendiente al cerrar el mes, o puedes hacerlo manualmente antes.',()=>commit(()=>{month().budget[f]+=amount;},'Disponible asignado a '+fundName(f)+'.'),'Asignar '+money(amount));}
async function importFile(file){if(!file)return;assert(file.size<=8000000,'La copia es demasiado grande. El límite es 8 MB.');let candidate;try{candidate=JSON.parse(await file.text(),(key,value)=>{if(['__proto__','prototype','constructor'].includes(key))throw Error('Clave no permitida.');return value;});candidate=migrateState(candidate);}catch(e){throw Error('No se importó nada. '+e.message);}
 confirmModal('Restaurar copia de seguridad','Esta copia contiene <strong>'+candidate.transactions.length+' movimientos, '+candidate.goals.length+' metas y '+Object.keys(candidate.months).length+' meses</strong>. Reemplazará todos los datos de este navegador. Tu información actual se descargará como respaldo antes de continuar.',()=>{exportJSON();const before=state;try{localStorage.setItem(APP_KEY,JSON.stringify(candidate));}catch(e){state=before;throw Error('No se puede guardar la copia en este navegador. Tus datos actuales se conservan.');}state=candidate;storageProblem='';simulator=null;transactionFilters={month:'current',type:'',category:'',person:''};render();toast('Copia restaurada correctamente.');},'Restaurar copia',true);
}
const actions={
 'daily-income':el=>dailyIncomeForm(el?.dataset.date||defaultDailyDate()),
 'menu':()=>{$('#sidebar').classList.toggle('open');$('#menu-shade').classList.toggle('open');},
 'theme':()=>commit(()=>{state.settings.theme=state.settings.theme==='light'?'dark':'light';}),
 'previous-month':()=>changeMonth(Object.keys(state.months).sort()[Object.keys(state.months).sort().indexOf(state.selectedMonth)-1]),
 'next-month':()=>changeMonth(Object.keys(state.months).sort()[Object.keys(state.months).sort().indexOf(state.selectedMonth)+1]),
 'select-month':el=>changeMonth(el.dataset.month),
 'new-transaction':()=>txForm(),
 'new-purchase':()=>txForm({type:'expense',category:'groceries'}),
 'gas-expense':()=>txForm({type:'expense',category:'gas',description:'Gasolina de la moto'}),
 'maintenance-expense':()=>txForm({type:'expense',account:'savings',from:'maintenance',description:'Mantenimiento de la moto'}),
 'fund-expense':()=>txForm({type:'expense',account:'savings',from:goal('equipment')?'goal:equipment':'rent'}),
 'new-saving':()=>txForm({type:'saving',to:'rent'}),
 'contribute':el=>txForm({type:'saving',to:el.dataset.fund,description:'Aporte a '+fundName(el.dataset.fund)}),
 'transfer':()=>txForm({type:'transfer',from:'rent',to:'emergency',description:'Transferencia entre fondos'}),
 'close-modal':closeModal,
 'new-goal':()=>goalForm(),
 'edit-goal':el=>goalForm(el.dataset.id),
 'delete-goal':el=>deleteGoal(el.dataset.id),
 'delete-transaction':el=>deleteTransaction(el.dataset.id),
 'redirect-goal':redirectCurrent,
 'view-goals':()=>navigate('goals'),
 'allocate':el=>allocateAvailable(el.dataset.fund),
 'stable-plan':activateStablePlan,
 'new-month':newMonthForm,
 'copy-month':copyPrevious,
 'activate-month':()=>{ensureOpen();commit(()=>{month().status='active';},'Mes marcado en curso.');},
 'close-month':closeMonthDialog,
 'reopen-month':()=>confirmModal('Reabrir '+monthName(state.selectedMonth),'Se retirarán únicamente los aportes automáticos de este cierre. Se conservarán todos los movimientos manuales. No se podrá reabrir si esos fondos ya fueron utilizados y quedarían sin saldo.',()=>commit(()=>reopenMonth(state.selectedMonth),'Mes reabierto.'),'Reabrir mes'),
 'reset-month':()=>{ensureOpen();confirmModal('Restablecer el presupuesto','Se recuperarán los importes iniciales de este mes. Los movimientos registrados se conservarán.',()=>commit(()=>{const m=newMonth(state.selectedMonth);m.budget.goals=Object.fromEntries(Object.entries(m.budget.goals).filter(([id])=>goal(id)));const old=month();old.income=m.income;old.extra=m.extra;old.incomeMode=m.incomeMode;old.budget=m.budget;old.essentials=m.essentials;old.stable=false;old.redirected=null;},'Presupuesto restablecido.'),'Restablecer',true);},
 'reset-simulator':()=>{resetSimulation();render();},
 'sim-preset':el=>{simulator.income=Number(el.dataset.value);render();},
 'export-json':exportJSON,
 'export-csv':exportCSV,
 'import-json':()=>$('#import-file').click(),
 'print':()=>{buildPrintReport();window.print();},
 'reset-all':()=>confirmModal('Borrar todos los datos','Se eliminará toda la información guardada y volverá el presupuesto inicial. Primero se descargará una copia automática de tus datos actuales.',()=>{exportJSON();const next=initialState();try{localStorage.setItem(APP_KEY,JSON.stringify(next));}catch(e){throw Error('No se pudo completar el reinicio. Tus datos siguen en esta sesión.');}state=next;storageProblem='';simulator=null;transactionFilters={month:'current',type:'',category:'',person:''};page='home';render();toast('Datos reiniciados.');},'Borrar y reiniciar',true)
};
function navigate(next){if(!navItems.some(n=>n[0]===next))return;page=next;$('#sidebar').classList.remove('open');$('#menu-shade').classList.remove('open');render();window.scrollTo({top:0,behavior:'instant'});$('#main').focus({preventScroll:true});}
function changeMonth(key){if(!state.months[key])return;state.selectedMonth=key;simulator=null;save();render();}
document.addEventListener('click',event=>{const nav=event.target.closest('[data-page]');if(nav){navigate(nav.dataset.page);return;}const el=event.target.closest('[data-action]');if(el){try{actions[el.dataset.action]?.(el);}catch(e){toast(e.message,true);}}});
document.addEventListener('change',event=>{const el=event.target;if(el.id==='month-select')changeMonth(el.value);if(el.dataset.filter){transactionFilters[el.dataset.filter]=el.value;render();}});
$('#menu-shade').addEventListener('click',()=>{$('#sidebar').classList.remove('open');$('#menu-shade').classList.remove('open');});
$('#dialog').addEventListener('click',event=>{if(event.target===$('#dialog')){const rect=$('#dialog').getBoundingClientRect();if(event.clientX<rect.left||event.clientX>rect.right||event.clientY<rect.top||event.clientY>rect.bottom)closeModal();}});
$('#dialog').addEventListener('cancel',()=>{modalSubmit=null;});
$('#import-file').addEventListener('change',async event=>{try{await importFile(event.target.files[0]);}catch(e){toast(e.message,true);}finally{event.target.value='';}});
/* Forms preview calculations while typing; submitted valid edits save immediately. */
document.addEventListener('input',event=>{
 const form=event.target.closest('form');if(!form)return;
 if(form.id==='budget-form'){try{const m=budgetFromForm(form);$('#budget-summary').innerHTML=budgetSummary(totals(state.selectedMonth,state,m));$('.form-error',form).textContent='';}catch{}}
 if(form.id==='simulator-form'){const name=event.target.name;try{simulator[name]=cents(event.target.value);$('#simulation-output').innerHTML=simulationOutput();event.target.setCustomValidity('');}catch{event.target.setCustomValidity('Escribe un monto válido, sin negativos y con hasta 2 decimales.');}}
 if(form.id==='equipment-form'){try{const fd=new FormData(form);$('#equipment-dec').textContent=money(sum(state.equipment.map(e=>cents(fd.get('dec_'+e.id)))));$('#equipment-jan').textContent=money(sum(state.equipment.map(e=>cents(fd.get('jan_'+e.id)))));}catch{}}
});
document.addEventListener('submit',event=>{
 const form=event.target;if(form.id==='modal-form')return;event.preventDefault();if(!form.reportValidity())return;const fd=new FormData(form);
 try{
  if(form.id==='budget-form'){ensureOpen();const edited=budgetFromForm(form);commit(()=>{state.months[state.selectedMonth]=edited;},'Presupuesto guardado. Todas las cifras están actualizadas.');}
  if(form.id==='equipment-form'){const values=state.equipment.map(e=>({...e,dec:cents(fd.get('dec_'+e.id)),jan:cents(fd.get('jan_'+e.id))}));commit(()=>{state.equipment=values;},'Distribución guardada.');}
  if(form.id==='gas-form'){ensureOpen();const value=cents(fd.get('weekly'));commit(()=>{month().budget.gas=Math.round(value*52/12);},'Presupuesto de gasolina actualizado.');}
  if(form.id==='essentials-form'){ensureOpen();commit(()=>{month().essentials=fd.getAll('essentials').filter(x=>expenseKeys.includes(x));},'Gastos esenciales actualizados.');}
  if(form.id==='opening-form'){assert(!Object.values(state.months).some(m=>m.status==='closed'),'Reabre los meses cerrados antes de cambiar los saldos iniciales.');const opening=Object.fromEntries(fundKeys.map(f=>[f,cents(fd.get(f))]));commit(()=>{state.initialFunds=opening;},'Saldos iniciales guardados.');}
  if(form.id==='settings-form'){const names=[fd.get('name1').trim(),fd.get('name2').trim()],couple=fd.get('couple').trim();assert(names.every(Boolean)&&couple,'Completa los nombres.');const limit=cents(fd.get('limit'));commit(()=>{state.settings={...state.settings,names,couple,limit,theme:fd.get('theme'),format:fd.get('format'),sameIess:fd.has('sameIess'),autoRedirect:fd.has('autoRedirect')};},'Configuración guardada.');}
 }catch(e){const error=$('.form-error',form);if(error)error.textContent=e.message;else toast(e.message,true);}
});
window.addEventListener('beforeprint',buildPrintReport);
/* Do not silently overwrite changes made from another tab. */
window.addEventListener('storage',event=>{if(event.key===APP_KEY&&event.newValue){try{const incoming=migrateState(JSON.parse(event.newValue));state=incoming;simulator=null;render();if($('#dialog').open)closeModal();toast('Datos actualizados desde otra pestaña.');}catch{toast('Otra pestaña guardó datos que no se pudieron recuperar.',true);}}});
state=loadState();
render();
if(!state.updatedAt&&!storageProblem){save();render();}
// Expose only the immutable calculation helpers for diagnostics, not live state.
window.NuestroPresupuesto={version:VERSION,snapshot:()=>clone(state),totals:()=>clone(totals()),validateBackup:value=>{migrateState(value);return true;}};

</script>
<!-- END_APPLICATION_SCRIPT -->
</body>
</html>
